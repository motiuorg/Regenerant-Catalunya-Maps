---
import Layout from "../components/Layout.astro";
import Button from "../components/Button.astro";
import { loadSectionConfig, fetchDatabaseRecords } from "../lib/notion";

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;

const sections = loadSectionConfig();
const actorsSection = sections.find((s) => s.id === "actors");

let actorCount = 0;
let catbisCount = 0;

if (actorsSection?.database_id) {
  try {
    const records = await fetchDatabaseRecords(actorsSection.database_id);
    actorCount = records.length;
    catbisCount = records.filter((r) => {
      const tag = r.properties["2NDTAG"];
      const tags = Array.isArray(tag) ? tag : tag ? [String(tag)] : [];
      return tags.some((t: string) => t.toLowerCase().includes("catbis"));
    }).length;
  } catch {
    // Silently fail on home page — actors page will show error
  }
}
---

<Layout title="Map" current="map" section="Regenerative Actors" dataset="Catalunya">
  <header class="hero">
    <div class="hero__inner section">
      <p class="eyebrow">Catalunya · {actorCount > 0 ? `${actorCount} actors mapped` : "work in progress"}</p>
      <h1 class="display">Regenerative actors across the territory</h1>
      <p class="lede">
        A living map of initiatives, cooperatives, and networks building regeneration in Catalunya —
        sourced from the ReFi BCN CRM and growing outward with Miceli.
      </p>
      <div class="hero__actions">
        <Button href={`${base}actors/`}>Browse {actorCount > 0 ? `${actorCount} actors` : "actors"}</Button>
        <Button variant="secondary" href={`${base}about/`}>About the project</Button>
      </div>
    </div>
  </header>

  <section class="map-shell section section--wide">
    <div class="map-card">
      <div class="map-card__header">
        <h2>Territorial map</h2>
        <p class="eyebrow">MapLibre + comarques · placeholder — coordinates coming soon</p>
      </div>
      <div class="map-placeholder">
        <p>🗺️ Map placeholder</p>
        <p>{actorCount > 0 ? `${actorCount} actors in the database` : "Connect your Notion database to populate the map."}</p>
        <p>{catbisCount > 0 ? `${catbisCount} tagged CATBIS` : ""}</p>
        <p>Replace this div with a MapLibre component once actor coordinates are available.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <h2>What this is</h2>
    <p>
      GQRegCat is Giulio's map of regenerative actors across Catalunya, built in collaboration with Miceli.
      It pulls from the ReFi BCN CRM Notion database and renders a public directory using the editorial-organic design system.
    </p>
    <ul class="checklist">
      <li><span class="eyebrow__num">01</span> Notion database connected — actors load at build time</li>
      <li><span class="eyebrow__num">02</span> Editorial-organic design system (fonts, colours, spacing)</li>
      <li><span class="eyebrow__num">03</span> MapLibre map ready for coordinates</li>
    </ul>
  </section>
</Layout>

<style>
.hero { padding: var(--space-20) var(--gutter); border-bottom: 1px solid var(--ink); background: var(--paper); }
.hero__inner { display: flex; flex-direction: column; gap: var(--space-5); max-width: var(--container-prose); }
.hero__actions { display: flex; gap: var(--space-3); flex-wrap: wrap; margin-top: var(--space-2); }
.map-shell { padding: var(--space-12) var(--gutter); }
.map-card { background: var(--surface-1); border: 1px solid var(--border-subtle); }
.map-card__header { padding: var(--space-5) var(--space-6); border-bottom: 1px solid var(--border-subtle); }
.map-card__header h2 { margin: 0; }
.map-placeholder { min-height: 24rem; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: var(--space-2); color: var(--text-muted); text-align: center; padding: var(--space-6); }
.map-placeholder code { font-family: var(--mono); background: var(--surface-2); padding: 0.1rem 0.3rem; }
.checklist { list-style: none; padding: 0; display: flex; flex-direction: column; gap: var(--space-3); margin-top: var(--space-5); }
.checklist li { display: flex; align-items: baseline; gap: var(--space-2); }
.eyebrow__num { color: var(--primary); margin-right: 0.6em; }
</style>
