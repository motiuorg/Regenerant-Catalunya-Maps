---
import Layout from "../components/Layout.astro";
import OrganicAmbient from "../components/OrganicAmbient.astro";
import { loadSectionConfig, fetchDatabaseRecords } from "../lib/notion";
import { hasCatbis } from "../lib/crm";

const sections = loadSectionConfig();
const actorsSection = sections.find((s) => s.id === "actors");
const programsSection = sections.find((s) => s.id === "programs");
const eventsSection = sections.find((s) => s.id === "events");

let actorCount = 0;
let programCount = 0;
let eventCount = 0;
let error: string | null = null;

async function fetchCount(section: typeof actorsSection) {
  if (!section?.database_id) return 0;
  const records = await fetchDatabaseRecords(section.database_id);
  return records.filter(hasCatbis).length;
}

try {
  [actorCount, programCount, eventCount] = await Promise.all([
    fetchCount(actorsSection),
    fetchCount(programsSection),
    fetchCount(eventsSection),
  ]);
} catch (e: any) {
  error = e.message ?? "Failed to fetch data from Notion.";
}

const totalCount = actorCount + programCount + eventCount;

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;

const exploreLinks = [
  {
    id: "organizations",
    title: "Organizations",
    description: "People, networks, organizations, and projects working on regeneration.",
    href: `${base}organizations/`,
    count: actorCount,
  },
  {
    id: "programs",
    title: "Programs and Initiatives",
    description: "Collective programs, networks, and initiatives driving systemic change.",
    href: `${base}programs/`,
    count: programCount,
  },
  {
    id: "events",
    title: "Events",
    description: "Gatherings, conferences, workshops, and community meetups.",
    href: `${base}events/`,
    count: eventCount,
  },
];
---

<Layout title="Home" current="home">
  <header class="hero">
    <OrganicAmbient />
    <div class="hero__inner section">
      <p class="eyebrow">Regenerant Catalunya Maps</p>
      <h1 class="display">Who is regenerating Catalunya?</h1>
      <p class="lede">
        A shared map of organizations, programs, and events working toward a regenerative future in Catalunya. Search, filter, and discover who is doing what — by theme, territory, and role.
      </p>

      <div class="stats">
        <span class="stats__number">{totalCount}</span>
        <span class="stats__label">organizations, programs, and events currently mapped</span>
      </div>

      <nav class="hero-actions" aria-label="Explore sections">
        <a href={`${base}organizations/`} class="hero-cta">
          <span class="hero-cta__label">Organizations</span>
          <span class="hero-cta__count">{actorCount}</span>
        </a>
        <a href={`${base}programs/`} class="hero-cta">
          <span class="hero-cta__label">Programs</span>
          <span class="hero-cta__count">{programCount}</span>
        </a>
        <a href={`${base}events/`} class="hero-cta">
          <span class="hero-cta__label">Events</span>
          <span class="hero-cta__count">{eventCount}</span>
        </a>
      </nav>

      {error && (
        <div class="error-banner">
          <p><strong>Data error:</strong> {error}</p>
        </div>
      )}
    </div>
  </header>

  <section class="section section--wide">
    <div class="link-grid">
      {exploreLinks.map((link) => (
        <a href={link.href} class="explore-card">
          <span class="explore-count">{link.count}</span>
          <h2 class="explore-title">{link.title}</h2>
          <p class="explore-description">{link.description}</p>
          <span class="explore-action">Browse →</span>
        </a>
      ))}
    </div>
  </section>
</Layout>

<style>
  .hero {
    position: relative;
    padding: var(--space-16) var(--gutter) var(--space-10);
    border-bottom: 1px solid var(--ink);
    background: var(--paper);
    text-align: center;
    overflow: hidden;
  }
  .hero__inner {
    position: relative;
    z-index: 1;
    max-width: var(--container-default);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero .eyebrow {
    margin-bottom: var(--space-3);
  }
  .hero h1 {
    margin-bottom: var(--space-5);
  }
  .hero .lede {
    max-width: 66ch;
    margin: 0 auto var(--space-8);
  }

  .stats {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    margin: 0 0 var(--space-8);
    padding: var(--space-6) var(--space-8);
    border: 1px solid var(--regen);
    background: var(--surface-1);
  }
  .stats__number {
    font-family: var(--serif);
    font-size: clamp(3.5rem, 8vw, 6rem);
    font-weight: 500;
    line-height: 1;
    color: var(--regen);
  }
  .stats__label {
    font-family: var(--mono);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    max-width: 24ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
  }
  .hero-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
    min-width: 8.5rem;
    padding: var(--space-4) var(--space-6);
    color: var(--text-primary);
    background: var(--paper);
    border: 1px solid var(--border-subtle);
    text-decoration: none;
    transition: border-color var(--t-fast), background-color var(--t-fast), transform var(--t-fast);
  }
  .hero-cta:hover {
    border-color: var(--primary);
    background: var(--surface-1);
    transform: translateY(-2px);
  }
  .hero-cta__label {
    font-family: var(--mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .hero-cta__count {
    font-family: var(--serif);
    font-size: 1.8rem;
    font-weight: 500;
    color: var(--primary);
    line-height: 1;
  }

  .link-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(22rem, 1fr));
    gap: var(--space-4);
  }

  .explore-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
    background: var(--surface-1);
    border: 1px solid var(--border-subtle);
    text-decoration: none;
    color: inherit;
    transition: border-color var(--t-fast), background-color var(--t-fast);
  }
  .explore-card:hover {
    border-color: var(--ink);
    background: var(--paper);
  }

  .explore-count {
    font-family: var(--mono);
    font-size: 2.5rem;
    font-weight: 500;
    line-height: 1;
    color: var(--regen);
  }
  .explore-title {
    font-family: var(--serif);
    font-size: 1.3rem;
    font-weight: 500;
    margin: 0;
    color: var(--ink);
  }
  .explore-description {
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--text-muted);
    margin: 0;
    flex: 1 1 auto;
  }
  .explore-action {
    font-family: var(--mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--primary);
    align-self: flex-start;
  }

  .error-banner {
    background: var(--surface-2);
    border: 1px solid var(--primary);
    padding: var(--space-4);
    font-family: var(--mono);
    font-size: 0.8rem;
    margin-top: var(--space-6);
    max-width: 60ch;
  }

  @media (max-width: 720px) {
    .hero {
      padding: var(--space-10) var(--gutter) var(--space-8);
    }
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
      max-width: 20rem;
    }
    .hero-cta {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
    .link-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
