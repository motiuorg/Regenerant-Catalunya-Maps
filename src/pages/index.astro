---
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta http-equiv="refresh" content={`0; url=${base}general-view/`} />
  <title>Regenerant Catalunya Maps</title>
</head>
<body>
  <p>
    Redirecting to <a href={`${base}general-view/`}>the ecosystem explorer</a>…
  </p>
</body>
</html>
