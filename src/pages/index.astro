---
import Layout from "../components/Layout.astro";

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
---

<Layout title="Home" current="home">
  <header class="hero">
    <div class="hero__inner section">
      <p class="eyebrow">Regenerant Catalunya Maps</p>
      <h1 class="display">Mapping regenerative projects and programs across Catalunya</h1>
      <p class="lede">
        A first attempt at aggregating regenerative actors, initiatives, and programs
        working in Catalunya — explored through bioregional priorities or territorial lenses.
      </p>
    </div>
  </header>

  <section class="section section--wide">
    <div class="entry-grid">
      <a href={`${base}priorities/`} class="entry-card">
        <span class="entry-card__eyebrow">Explore by</span>
        <h2 class="entry-card__title">Bioregional priority</h2>
        <p class="entry-card__text">
          Browse CATBIS entities through six lenses: ecosystems, food, energy, water,
          circular economy, and social equity.
        </p>
        <span class="entry-card__link">Open the priority gallery →</span>
      </a>

      <a href={`${base}territory/`} class="entry-card">
        <span class="entry-card__eyebrow">Explore by</span>
        <h2 class="entry-card__title">Territory</h2>
        <p class="entry-card__text">
          Browse CATBIS entities by comarca and climate zone across Catalunya.
        </p>
        <span class="entry-card__link">Open the territory gallery →</span>
      </a>
    </div>
  </section>

  <section class="section">
    <div class="note">
      <p>
        This is a living directory. Every entity shown is tagged <code>CATBIS</code> in the
        ReFi BCN CRM and carries information about its bioregional priorities, territorial
        scope, and ontology. Filters can be combined: they narrow the gallery by matching
        any selected tag within each group.
      </p>
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding: var(--space-16) var(--gutter) var(--space-12);
    border-bottom: 1px solid var(--ink);
    background: var(--paper);
  }
  .hero__inner {
    max-width: var(--container-default);
    margin: 0 auto;
  }
  .hero .eyebrow {
    margin-bottom: var(--space-4);
  }
  .hero h1 {
    max-width: 18ch;
    margin-bottom: var(--space-5);
  }
  .hero .lede {
    max-width: 60ch;
  }

  .entry-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: var(--space-5);
  }
  .entry-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
    background: var(--surface-1);
    border: 1px solid var(--border-subtle);
    text-decoration: none;
    color: inherit;
    transition: border-color var(--t-fast), translate var(--t-med), box-shadow var(--t-med);
  }
  .entry-card:hover {
    border-color: var(--ink);
    translate: 0 -2px;
    box-shadow: 4px 4px 0 color-mix(in srgb, var(--ink) 12%, transparent);
  }
  .entry-card__eyebrow {
    font-family: var(--mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
  }
  .entry-card__title {
    font-family: var(--serif);
    font-size: var(--text-xl);
    margin: 0;
  }
  .entry-card__text {
    font-size: var(--text-base);
    color: var(--text-muted);
    line-height: var(--leading-body);
    flex: 1;
    margin: 0;
  }
  .entry-card__link {
    font-family: var(--mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--primary);
    margin-top: var(--space-2);
  }

  .note {
    max-width: var(--container-prose);
    margin: 0 auto;
    padding: var(--space-6);
    background: var(--surface-1);
    border: 1px solid var(--border-subtle);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
  .note p { margin: 0; }
  .note code {
    background: var(--surface-2);
    padding: 0.1rem 0.3rem;
    font-family: var(--mono);
  }
</style>
