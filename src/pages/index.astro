---
import Layout from "../components/Layout.astro";
import { loadSectionConfig, fetchDatabaseRecords } from "../lib/notion";
import { hasCatbis } from "../lib/crm";

const sections = loadSectionConfig();
const actorsSection = sections.find((s) => s.id === "actors");
const programsSection = sections.find((s) => s.id === "programs");
const eventsSection = sections.find((s) => s.id === "events");

let actorCount = 0;
let programCount = 0;
let eventCount = 0;
let error: string | null = null;

async function fetchCount(section: typeof actorsSection) {
  if (!section?.database_id) return 0;
  const records = await fetchDatabaseRecords(section.database_id);
  return records.filter(hasCatbis).length;
}

try {
  [actorCount, programCount, eventCount] = await Promise.all([
    fetchCount(actorsSection),
    fetchCount(programsSection),
    fetchCount(eventsSection),
  ]);
} catch (e: any) {
  error = e.message ?? "Failed to fetch data from Notion.";
}

const totalCount = actorCount + programCount + eventCount;

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;

const exploreLinks = [
  {
    id: "organizations",
    title: "Organizations",
    description: "Discover regenerative actors, projects, networks, and organizations across Catalunya. Filter by priority area and territory.",
    href: `${base}organizations/`,
    count: actorCount,
  },
  {
    id: "programs",
    title: "Programs and Initiatives",
    description: "Explore programs, collective initiatives, and networks driving regenerative change in Catalunya.",
    href: `${base}programs/`,
    count: programCount,
  },
  {
    id: "events",
    title: "Events",
    description: "Find upcoming and past gatherings, conferences, workshops, and community events related to regeneration.",
    href: `${base}events/`,
    count: eventCount,
  },
];
---

<Layout title="Home" current="home">
  <header class="hero">
    <div class="hero__inner section">
      <p class="eyebrow">Regenerant Catalunya Maps</p>
      <h1 class="display">Explore the ecosystem</h1>
      <p class="lede">
        A first attempt at aggregating regenerative projects, programs, and events related to regeneration in Catalunya. Use the pages below to browse by type of actor, or go directly to the Organizations page to filter by priority area and territory.
      </p>

      <p class="stats">
        <strong>{totalCount}</strong> organizations, programs and events currently mapped
      </p>

      {error && (
        <div class="error-banner">
          <p><strong>Data error:</strong> {error}</p>
        </div>
      )}
    </div>
  </header>

  <section class="section section--wide">
    <div class="link-grid">
      {exploreLinks.map((link) => (
        <a href={link.href} class="explore-card">
          <span class="explore-count">{link.count}</span>
          <h2 class="explore-title">{link.title}</h2>
          <p class="explore-description">{link.description}</p>
          <span class="explore-action">Browse →</span>
        </a>
      ))}
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding: var(--space-16) var(--gutter) var(--space-10);
    border-bottom: 1px solid var(--ink);
    background: var(--paper);
    text-align: center;
  }
  .hero__inner {
    max-width: var(--container-default);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .hero .eyebrow {
    margin-bottom: var(--space-3);
  }
  .hero h1 {
    margin-bottom: var(--space-5);
  }
  .hero .lede {
    max-width: 70ch;
    margin: 0 auto var(--space-8);
  }

  .stats {
    font-family: var(--mono);
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink);
    margin: 0;
    padding: var(--space-4) var(--space-6);
    border: 1px solid var(--ink);
    background: var(--surface-1);
  }
  .stats strong {
    color: var(--primary);
  }

  .link-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(22rem, 1fr));
    gap: var(--space-4);
  }

  .explore-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
    background: var(--surface-1);
    border: 1px solid var(--border-subtle);
    text-decoration: none;
    color: inherit;
    transition: border-color var(--t-fast), background-color var(--t-fast);
  }
  .explore-card:hover {
    border-color: var(--ink);
    background: var(--paper);
  }

  .explore-count {
    font-family: var(--mono);
    font-size: 2.5rem;
    font-weight: 500;
    line-height: 1;
    color: var(--primary);
  }
  .explore-title {
    font-family: var(--serif);
    font-size: 1.3rem;
    font-weight: 500;
    margin: 0;
    color: var(--ink);
  }
  .explore-description {
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--text-muted);
    margin: 0;
    flex: 1 1 auto;
  }
  .explore-action {
    font-family: var(--mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--primary);
    align-self: flex-start;
  }

  .error-banner {
    background: var(--surface-2);
    border: 1px solid var(--primary);
    padding: var(--space-4);
    font-family: var(--mono);
    font-size: 0.8rem;
    margin-top: var(--space-6);
    max-width: 60ch;
  }

  @media (max-width: 720px) {
    .hero {
      padding: var(--space-10) var(--gutter) var(--space-8);
    }
    .link-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
