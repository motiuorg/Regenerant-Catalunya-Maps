---
import Layout from "../components/Layout.astro";
import OrganicAmbient from "../components/OrganicAmbient.astro";
import OrgMap from "../components/OrgMap.astro";
import { loadSectionConfig, fetchDatabaseRecords } from "../lib/notion";
import { hasCatbis, normalizeRecord, isOrgActor } from "../lib/crm";
import type { CrmActor } from "../lib/crm";
import fs from "node:fs";
import path from "node:path";
import yaml from "js-yaml";

// Public submission form (Notion form view URL, from site.yaml). While unset,
// the CTA falls back to email so the button works before the form is published.
const site = yaml.load(
    fs.readFileSync(path.join(process.cwd(), "src/data/site.yaml"), "utf8"),
) as { submitFormUrl?: string };
const submitFormUrl = String(site.submitFormUrl ?? "").trim();
const submitHref = submitFormUrl || "mailto:hello@motiu.org";
const submitKey = submitFormUrl ? "submit.addEntry" : "submit.writeUs";
const submitLabel = submitFormUrl ? "Add an entry →" : "Write to us →";

const sections = loadSectionConfig();
const actorsSection = sections.find((s) => s.id === "actors");
const programsSection = sections.find((s) => s.id === "programs");
const eventsSection = sections.find((s) => s.id === "events");

let actors: CrmActor[] = [];
let programCount = 0;
let eventCount = 0;
let error: string | null = null;

async function fetchRecords(section: typeof actorsSection) {
    if (!section?.database_id) return [];
    return fetchDatabaseRecords(section.database_id);
}

try {
    const [actorRecords, programRecords, eventRecords] = await Promise.all([
        fetchRecords(actorsSection),
        fetchRecords(programsSection),
        fetchRecords(eventsSection),
    ]);
    actors = actorRecords
        .filter(hasCatbis)
        .map(normalizeRecord)
        .filter(isOrgActor);
    programCount = programRecords.filter(hasCatbis).length;
    eventCount = eventRecords.filter(hasCatbis).length;
} catch (e: any) {
    error = e.message ?? "Failed to fetch data from Notion.";
}

const actorCount = actors.length;
const totalCount = actorCount + programCount + eventCount;

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;

const exploreLinks = [
    {
        id: "organizations",
        title: "Organizations",
        titleKey: "home.orgTitle",
        description:
            "People, networks, organizations, and projects working on regeneration.",
        descriptionKey: "home.orgDesc",
        href: `${base}organizations/`,
        count: actorCount,
    },
    {
        id: "programs",
        title: "Programs and Initiatives",
        titleKey: "home.progTitle",
        description:
            "Collective programs, networks, and initiatives driving systemic change.",
        descriptionKey: "home.progDesc",
        href: `${base}programs/`,
        count: programCount,
    },
    {
        id: "events",
        title: "Events",
        titleKey: "home.evTitle",
        description:
            "Gatherings, conferences, workshops, and community meetups.",
        descriptionKey: "home.evDesc",
        href: `${base}events/`,
        count: eventCount,
    },
];
---

<Layout
    title="Home"
    current="home"
    description="An open mapping process of the organizations, programs and events working toward a regenerative Catalunya. Search, filter and explore who is doing what — and suggest an entry."
>
    <header class="hero">
        <OrganicAmbient />
        <div class="hero__inner section">
            <h1 class="display" data-i18n="home.title">
                Who is regenerating Catalunya?
            </h1>
            <p class="lede" data-i18n="home.lede">
                An open mapping process currently focused on organizations and
                initiatives working toward a regenerative Catalunya. Search,
                filter, and discover who is doing what, as well as what you can
                contribute to this movement!
            </p>

            <p class="stats">
                <strong>{totalCount}</strong>{" "}
                <span data-i18n="home.stats">
                    organizations, programs, and events currently mapped
                </span>
            </p>

            <div class="hero-actions">
                <a
                    class="hero-actions__cta"
                    href={submitHref}
                    target="_blank"
                    rel="noopener"
                    data-i18n={submitKey}
                >
                    {submitLabel}
                </a>
                <a
                    class="hero-actions__link"
                    href={`${base}contribute/`}
                    data-i18n="home.howToContribute"
                >
                    How to contribute to regeneration
                </a>
            </div>

            <OrgMap actors={actors} showTitle={false} />

            {error && (
                <div class="error-banner">
                    <p>
                        <strong data-i18n="common.dataError">
                            Data error:
                        </strong>{" "}
                        {error}
                    </p>
                </div>
            )}
        </div>
    </header>

    <section class="section section--wide">
        <p class="section-prompt" data-i18n="home.prompt">
            Start exploring the map:
        </p>
        <div class="link-grid">
            {exploreLinks.map((link) => (
                <a href={link.href} class="explore-card">
                    <span class="explore-count">{link.count}</span>
                    <h2 class="explore-title" data-i18n={link.titleKey}>
                        {link.title}
                    </h2>
                    <p
                        class="explore-description"
                        data-i18n={link.descriptionKey}
                    >
                        {link.description}
                    </p>
                    <span class="explore-action" data-i18n="home.browse">
                        Browse →
                    </span>
                </a>
            ))}
        </div>
    </section>
</Layout>

<style>
    .hero {
        position: relative;
        padding: var(--space-16) 0 var(--space-6);
        border-bottom: 1px solid var(--ink);
        background: var(--paper);
        text-align: center;
        overflow: hidden;
    }
    .hero__inner {
        position: relative;
        z-index: 1;
        max-width: var(--container-default);
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .hero h1 {
        margin-bottom: var(--space-5);
    }
    .hero .lede {
        max-width: 66ch;
        margin: 0 auto var(--space-8);
    }

    .stats {
        font-family: var(--serif);
        font-size: clamp(1.2rem, 2.5vw, 1.5rem);
        font-style: italic;
        line-height: 1.5;
        color: var(--text-muted);
        margin: 0 0 var(--space-4);
        max-width: 60ch;
    }
    .stats strong {
        font-family: var(--serif);
        font-style: normal;
        font-size: clamp(1.8rem, 3.5vw, 2.6rem);
        font-weight: 500;
        color: var(--regen);
    }

    .hero-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: var(--space-3) var(--space-5);
        margin: 0 0 var(--space-6);
    }
    .hero-actions__cta {
        display: inline-flex;
        align-items: center;
        background: var(--regen);
        color: var(--regen-foreground);
        font-family: var(--mono);
        font-size: 0.78rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.07em;
        text-decoration: none;
        padding: 0.7rem 1.4rem;
        border: 1px solid var(--regen);
        border-radius: var(--radius-pill);
        white-space: nowrap;
        transition:
            background-color var(--t-fast),
            color var(--t-fast),
            translate var(--t-fast);
    }
    .hero-actions__cta:hover,
    .hero-actions__cta:focus-visible {
        background: var(--regen-hover);
        border-color: var(--regen-hover);
        color: var(--regen-foreground);
        translate: 0 -1px;
    }
    .hero-actions__link {
        font-family: var(--mono);
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--text-muted);
        text-decoration: none;
        white-space: nowrap;
        border-bottom: 1px solid transparent;
        padding-bottom: 1px;
    }
    .hero-actions__link:hover,
    .hero-actions__link:focus-visible {
        color: var(--ink);
        border-bottom-color: var(--ink);
    }

    .section-prompt {
        font-family: var(--mono);
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--text-muted);
        margin: 0 0 var(--space-4);
    }

    .link-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(22rem, 1fr));
        gap: var(--space-4);
    }

    .explore-card {
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
        padding: var(--space-6);
        background: var(--surface-1);
        border: 1px solid var(--border-subtle);
        text-decoration: none;
        color: inherit;
        transition:
            border-color var(--t-fast),
            background-color var(--t-fast),
            transform var(--t-fast);
    }
    .explore-card:hover {
        border-color: var(--regen);
        background: var(--paper);
        transform: translateY(-3px);
    }

    .explore-count {
        font-family: var(--mono);
        font-size: 2.5rem;
        font-weight: 500;
        line-height: 1;
        color: var(--regen);
    }
    .explore-title {
        font-family: var(--serif);
        font-size: 1.3rem;
        font-weight: 500;
        margin: 0;
        color: var(--ink);
    }
    .explore-description {
        font-size: 0.92rem;
        line-height: 1.55;
        color: var(--text-muted);
        margin: 0;
        flex: 1 1 auto;
    }
    .explore-action {
        font-family: var(--mono);
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--primary);
        align-self: flex-start;
    }

    .error-banner {
        background: var(--surface-2);
        border: 1px solid var(--primary);
        padding: var(--space-4);
        font-family: var(--mono);
        font-size: 0.8rem;
        margin-top: var(--space-6);
        max-width: 60ch;
    }

    @media (max-width: 720px) {
        .hero {
            padding: var(--space-10) 0 var(--space-8);
        }
        .link-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
