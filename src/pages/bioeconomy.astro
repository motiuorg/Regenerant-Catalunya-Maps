---
import Layout from "../components/Layout.astro";
import OrganicAmbient from "../components/OrganicAmbient.astro";
import { loadSectionConfig, fetchDatabaseRecords } from "../lib/notion";
import {
  normalizeRecord,
  hasBioeconomyMeme,
  uniqueValues,
} from "../lib/crm";
import type { CrmActor } from "../lib/crm";

const sections = loadSectionConfig();
const bioeconomySection = sections.find((s) => s.id === "bioeconomy") ?? sections.find((s) => s.id === "actors");

let records: any[] = [];
let error: string | null = null;
if (bioeconomySection?.database_id) {
  try {
    records = await fetchDatabaseRecords(bioeconomySection.database_id);
  } catch (e: any) {
    error = e.message ?? "Failed to fetch bioeconomy actors from Notion.";
  }
} else {
  error = "No database_id configured for bioeconomy section.";
}

const actors: CrmActor[] = records
  .filter(hasBioeconomyMeme)
  .map(normalizeRecord);

const subcategoryOptions = uniqueValues(actors, "bioeconomySubcategories").filter(
  (s) => s.length < 60 // exclude accidental prose entries until CRM is cleaned
);

const subcategoryColors: Record<string, string> = {
  "alt-protein-foodtech": "var(--lib-orange)",
  "biomaterials-industrial-biotech": "var(--lib-blue)",
  "blue-bioeconomy-marine-biotech": "var(--lib-ocean)",
  "circular-organic-valorization": "var(--lib-green)",
  "agri-biotech-regenerative-inputs": "var(--pillar-tissue-mid)",
  "climate-biotech-bioenergy-tech": "var(--lib-yellow)",
  "water-biotech-bioremediation": "var(--pillar-neural-mid)",
};

function subcategoryLabel(slug: string): string {
  const labels: Record<string, string> = {
    "alt-protein-foodtech": "Alternative proteins / foodtech",
    "biomaterials-industrial-biotech": "Biomaterials / industrial biotech",
    "blue-bioeconomy-marine-biotech": "Blue bioeconomy / marine biotech",
    "circular-organic-valorization": "Circular organic valorization",
    "agri-biotech-regenerative-inputs": "Agri-biotech / regenerative inputs",
    "climate-biotech-bioenergy-tech": "Climate / bioenergy tech",
    "water-biotech-bioremediation": "Water biotech / bioremediation",
  };
  if (labels[slug]) return labels[slug];
  return slug
    .split(/[-_]/)
    .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
    .join(" ");
}

const safeJson = (obj: any) =>
  JSON.stringify(obj)
    .replace(/</g, "\\u003c")
    .replace(/>/g, "\\u003e")
    .replace(/&/g, "\\u0026");

const pageDescription =
  "Bioeconomy introduces the material-economic subsystem within the wider regeneration field in Catalunya. It asks: who is building bio-based, circular, regenerative value chains using biological resources? This spotlight surfaces entities at the intersection of environmental regeneration and biotech, life sciences, climate tech, and agri-food tech.";
---

<Layout
  title="Bioeconomy"
  description={pageDescription}
  current="bioeconomy"
>
  <header class="hero hero--compact">
    <OrganicAmbient />
    <div class="hero__inner section">
      <p class="eyebrow">Regenerant Catalunya Maps</p>
      <h1 class="display">Bioeconomy</h1>
      <p class="lede">
        Bioeconomy is the material-economic subsystem within the wider regeneration field in
        Catalunya. This page asks: <em>who is building bio-based, circular, regenerative value
        chains using biological resources here?</em>
      </p>
      <p class="lede lede--secondary">
        The spotlight below surfaces entities at the intersection of environmental regeneration
        and biotech, life sciences, climate tech, and agri-food tech. Filter by subcategory
        or search by name to explore the map.
      </p>
    </div>
  </header>

  <section class="section section--wide">
    {error && (
      <div class="error-banner">
        <p><strong>Data error:</strong> {error}</p>
      </div>
    )}

    <div class="filter-panel">
      <div class="filter-panel__header">
        <h2 class="filter-panel__title">Explore the bioeconomy map</h2>
        <button type="button" class="filter-clear" id="clear-filters">Clear all</button>
      </div>

      <div class="filter-search">
        <label class="filter-label" for="search-input">Search by name</label>
        <input
          type="search"
          id="search-input"
          class="search-input"
          placeholder="Type an organization name…"
          autocomplete="off"
        />
      </div>

      <div class="filter-options">
        <label class="spotlight-toggle">
          <input type="checkbox" id="spotlight-toggle" />
          <span>Spotlight only: biotech / life sciences / climate tech / agri-food tech</span>
        </label>
      </div>

      {subcategoryOptions.length > 0 && (
        <fieldset class="filter-group">
          <legend class="filter-label">Filter by subcategory</legend>
          <div class="filter-buttons" id="subcategory-filters">
            {subcategoryOptions.map((tag) => (
              <button
                type="button"
                class="filter-btn"
                data-filter-value={tag}
                style={`--filter-color: ${subcategoryColors[tag] ?? "var(--primary)"}`}
                aria-pressed="false"
              >
                {subcategoryLabel(tag)}
              </button>
            ))}
          </div>
        </fieldset>
      )}
    </div>

    <p class="count" id="gallery-count">Loading…</p>

    <div class="actor-grid" id="actor-gallery">
      {actors.map((actor) => (
        <article class="actor-card" data-actor={safeJson(actor)}>
          <div class="actor-card__main">
            <div class="actor-card__header">
              <h3 class="actor-name">{actor.name}</h3>
              {actor.actorType && <span class="actor-type">{actor.actorType}</span>}
            </div>

            <p class="actor-description">
              {actor.description || "No description available."}
            </p>

            <div class="actor-badges">
              {actor.bioeconomySubcategories
                .filter((tag) => tag.length < 60)
                .map((tag) => (
                  <span
                    class="subcategory-badge"
                    style={`--badge-color: ${subcategoryColors[tag] ?? "var(--primary)"}`}
                  >
                    {subcategoryLabel(tag)}
                  </span>
                ))}
              {actor.area2.slice(0, 2).map((area) => (
                <span class="territory-badge">{area}</span>
              ))}
            </div>

            <div class="actor-actions">
              {actor.website && (
                <a
                  href={actor.website}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="actor-link"
                >
                  Website →
                </a>
              )}
              <button type="button" class="details-toggle" data-details-toggle>
                Details
              </button>
            </div>
          </div>

          <div class="actor-card__details" hidden>
            {actor.whyItMatters && (
              <div class="detail-block">
                <h4>Why it matters</h4>
                <p>{actor.whyItMatters}</p>
              </div>
            )}

            {actor.publicEmail && (
              <div class="detail-block">
                <h4>Public contact</h4>
                <a href={`mailto:${actor.publicEmail}`} class="actor-link">
                  {actor.publicEmail}
                </a>
              </div>
            )}

            {actor.linkedin && (
              <div class="detail-block">
                <h4>LinkedIn</h4>
                <a
                  href={actor.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="actor-link"
                >
                  {actor.linkedin}
                </a>
              </div>
            )}

            {actor.themes.length > 0 && (
              <div class="detail-block">
                <h4>Themes</h4>
                <div class="detail-tags">
                  {actor.themes.map((t) => <span class="detail-tag">{t}</span>)}
                </div>
              </div>
            )}

            {actor.bioeconomySubcategories.length > 0 && (
              <div class="detail-block">
                <h4>Bioeconomy subcategories</h4>
                <div class="detail-tags">
                  {actor.bioeconomySubcategories
                    .filter((tag) => tag.length < 60)
                    .map((t) => <span class="detail-tag">{subcategoryLabel(t)}</span>)}
                </div>
              </div>
            )}

            {actor.ontologyTags.length > 0 && (
              <div class="detail-block">
                <h4>Ontology tags</h4>
                <div class="detail-tags">
                  {actor.ontologyTags.map((t) => <span class="detail-tag">{t}</span>)}
                </div>
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <script is:inline>
    (function () {
      const cards = Array.from(document.querySelectorAll(".actor-card"));
      const actors = cards.map((el) => JSON.parse(el.dataset.actor || "{}"));
      const countLabel = document.getElementById("gallery-count");
      const searchInput = document.getElementById("search-input");
      const clearBtn = document.getElementById("clear-filters");
      const spotlightToggle = document.getElementById("spotlight-toggle");

      const filters = {
        subcategories: [],
        search: "",
        spotlightOnly: false,
      };

      function normalize(str) {
        return String(str || "")
          .toLowerCase()
          .normalize("NFD")
          .replace(/\p{Diacritic}/gu, "");
      }

      function matchesSearch(actor) {
        const term = normalize(filters.search).trim();
        if (!term) return true;
        const haystack = normalize(
          [actor.name, actor.description, actor.whyItMatters].join(" ")
        );
        return haystack.includes(term);
      }

      function matchesSubcategories(actor) {
        if (filters.subcategories.length === 0) return true;
        const actorValues = actor.bioeconomySubcategories || [];
        return filters.subcategories.some((v) => actorValues.includes(v));
      }

      function matchesSpotlight(actor) {
        if (!filters.spotlightOnly) return true;
        const subs = actor.bioeconomySubcategories || [];
        return subs.length > 0;
      }

      function isVisible(actor) {
        return (
          matchesSearch(actor) &&
          matchesSubcategories(actor) &&
          matchesSpotlight(actor)
        );
      }

      function updateGallery() {
        let visible = 0;
        for (let i = 0; i < actors.length; i++) {
          const show = isVisible(actors[i]);
          cards[i].classList.toggle("is-hidden", !show);
          if (show) visible++;
        }
        if (countLabel) {
          countLabel.textContent = `Showing ${visible} of ${actors.length} bioeconomy actors`;
        }
      }

      function bindButtonGroup(containerId, key) {
        document.querySelectorAll(`#${containerId} .filter-btn`).forEach((btn) => {
          btn.addEventListener("click", () => {
            const value = btn.dataset.filterValue;
            const active = btn.classList.toggle("active");
            btn.setAttribute("aria-pressed", String(active));
            if (active) {
              filters[key].push(value);
            } else {
              filters[key] = filters[key].filter((v) => v !== value);
            }
            updateGallery();
          });
        });
      }

      bindButtonGroup("subcategory-filters", "subcategories");

      if (searchInput) {
        searchInput.addEventListener("input", () => {
          filters.search = searchInput.value;
          updateGallery();
        });
      }

      if (spotlightToggle) {
        spotlightToggle.addEventListener("change", () => {
          filters.spotlightOnly = spotlightToggle.checked;
          updateGallery();
        });
      }

      if (clearBtn) {
        clearBtn.addEventListener("click", () => {
          filters.subcategories = [];
          filters.search = "";
          filters.spotlightOnly = false;
          if (searchInput) searchInput.value = "";
          if (spotlightToggle) spotlightToggle.checked = false;
          document.querySelectorAll(".filter-btn.active").forEach((btn) => {
            btn.classList.remove("active");
            btn.setAttribute("aria-pressed", "false");
          });
          updateGallery();
        });
      }

      document.querySelectorAll("[data-details-toggle]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const card = btn.closest(".actor-card");
          const details = card.querySelector(".actor-card__details");
          const hidden = details.hidden;
          details.hidden = !hidden;
          btn.textContent = hidden ? "Hide details" : "Details";
        });
      });

      updateGallery();
    })();
  </script>
</Layout>

<style>
  .hero--compact {
    position: relative;
    padding: var(--space-12) var(--gutter) var(--space-8);
    border-bottom: 1px solid var(--ink);
    background: var(--paper);
    overflow: hidden;
  }
  .hero__inner {
    position: relative;
    z-index: 1;
    max-width: var(--container-default);
    margin: 0 auto;
  }
  .hero--compact .eyebrow {
    margin-bottom: var(--space-3);
  }
  .hero--compact h1 {
    margin-bottom: var(--space-4);
  }
  .hero--compact .lede {
    max-width: 70ch;
  }
  .lede--secondary {
    color: var(--text-muted);
    margin-top: var(--space-3);
  }

  .filter-panel {
    background: var(--surface-1);
    border: 1px solid var(--border-subtle);
    padding: var(--space-6);
    margin-bottom: var(--space-6);
  }
  .filter-panel__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--border-subtle);
  }
  .filter-panel__title {
    font-family: var(--serif);
    font-size: 1.1rem;
    font-weight: 500;
    margin: 0;
  }
  .filter-clear {
    font-family: var(--mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: var(--space-2) var(--space-3);
    background: transparent;
    color: var(--primary);
    border: 1px solid var(--border-subtle);
    cursor: pointer;
    transition: background-color var(--t-fast), border-color var(--t-fast);
  }
  .filter-clear:hover {
    background: var(--surface-2);
    border-color: var(--primary);
  }

  .filter-search {
    margin-bottom: var(--space-5);
  }
  .filter-search .filter-label {
    display: block;
    margin-bottom: var(--space-2);
  }
  .search-input {
    width: 100%;
    max-width: 40rem;
    padding: var(--space-3) var(--space-4);
    font-family: var(--sans);
    font-size: var(--text-base);
    color: var(--text-primary);
    background: var(--paper);
    border: 1px solid var(--border-subtle);
    outline: none;
    transition: border-color var(--t-fast);
  }
  .search-input:focus {
    border-color: var(--primary);
  }

  .filter-options {
    margin-bottom: var(--space-5);
  }
  .spotlight-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--sans);
    font-size: 0.92rem;
    color: var(--text-primary);
    cursor: pointer;
  }
  .spotlight-toggle input {
    width: 1.1rem;
    height: 1.1rem;
    accent-color: var(--primary);
    cursor: pointer;
  }

  .filter-group {
    margin: 0;
    padding: 0;
    border: none;
  }
  .filter-label {
    display: block;
    font-family: var(--mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    margin-bottom: var(--space-2);
  }

  .filter-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .filter-btn {
    font-family: var(--mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: var(--space-2) var(--space-3);
    background: var(--paper);
    color: var(--text-primary);
    border: 1px solid var(--border-subtle);
    cursor: pointer;
    transition: background-color var(--t-fast), color var(--t-fast), border-color var(--t-fast);
  }
  .filter-btn:hover {
    border-color: var(--ink);
  }
  .filter-btn.active {
    background: color-mix(in srgb, var(--filter-color, var(--primary)) 14%, var(--surface-1));
    color: var(--filter-color, var(--primary));
    border-color: var(--filter-color, var(--primary));
  }

  .count {
    font-family: var(--mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin: 0 0 var(--space-6);
  }

  .actor-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(28rem, 1fr));
    gap: var(--space-4);
  }

  .actor-card {
    background: var(--surface-1);
    border: 1px solid var(--border-subtle);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    transition: border-color var(--t-fast);
  }
  .actor-card:hover {
    border-color: var(--ink);
  }
  .actor-card.is-hidden {
    display: none;
  }

  .actor-card__main {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .actor-card__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .actor-name {
    font-family: var(--serif);
    font-size: 1.2rem;
    font-weight: 500;
    margin: 0;
    color: var(--ink);
    letter-spacing: -0.01em;
  }
  .actor-type {
    font-family: var(--mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.2rem 0.5rem;
    background: var(--surface-2);
    color: var(--text-muted);
    border: 1px solid var(--border-subtle);
    white-space: nowrap;
  }
  .actor-description {
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--text-muted);
    margin: 0;
  }

  .actor-badges {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .subcategory-badge {
    font-family: var(--mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.15rem 0.4rem;
    background: color-mix(in srgb, var(--badge-color, var(--ink)) 14%, var(--surface-1));
    color: var(--badge-color, var(--ink));
    border: 1px solid var(--badge-color, var(--ink));
  }
  .territory-badge {
    font-family: var(--mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.15rem 0.4rem;
    background: var(--surface-2);
    color: var(--text-muted);
    border: 1px solid var(--border-subtle);
  }

  .actor-actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-1);
  }
  .actor-link {
    font-family: var(--mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--primary);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color var(--t-fast);
  }
  .actor-link:hover {
    border-bottom-color: var(--primary);
  }
  .details-toggle {
    font-family: var(--mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.25rem 0.75rem;
    background: var(--surface-2);
    color: var(--text-primary);
    border: 1px solid var(--border-subtle);
    cursor: pointer;
    transition: background-color var(--t-fast), border-color var(--t-fast);
  }
  .details-toggle:hover {
    background: var(--paper);
    border-color: var(--ink);
  }

  .actor-card__details {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px dashed var(--border-subtle);
  }
  .actor-card__details[hidden] {
    display: none;
  }
  .detail-block h4 {
    font-family: var(--mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin: 0 0 var(--space-1);
  }
  .detail-block p,
  .detail-block ul {
    font-size: 0.88rem;
    color: var(--text-primary);
    margin: 0;
    line-height: 1.55;
  }
  .detail-block ul {
    padding-left: 1.2rem;
  }
  .detail-block li {
    margin-bottom: 0.25rem;
  }
  .detail-tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .detail-tag {
    font-family: var(--mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.15rem 0.4rem;
    background: var(--surface-2);
    color: var(--text-muted);
  }

  .error-banner {
    background: var(--surface-2);
    border: 1px solid var(--primary);
    padding: var(--space-4);
    font-family: var(--mono);
    font-size: 0.8rem;
    margin-bottom: var(--space-6);
  }

  @media (max-width: 720px) {
    .actor-grid {
      grid-template-columns: 1fr;
    }
    .actor-card__header {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
