---
import Layout from "../components/Layout.astro";
import { loadSectionConfig, fetchDatabaseRecords } from "../lib/notion";
import { normalizeProgram, hasCatbis } from "../lib/crm";
import type { CrmProgram } from "../lib/crm";

const sections = loadSectionConfig();
const programsSection = sections.find((s) => s.id === "programs");

let records: any[] = [];
let error: string | null = null;
if (programsSection?.database_id) {
  try {
    records = await fetchDatabaseRecords(programsSection.database_id);
  } catch (e: any) {
    error = e.message ?? "Failed to fetch programs from Notion.";
  }
} else {
  error = "No database_id configured for programs section.";
}

const programs: CrmProgram[] = records.filter(hasCatbis).map(normalizeProgram);
---

<Layout title="Programs and Initiatives" current="programs">
  <header class="hero hero--compact">
    <div class="hero__inner section">
      <p class="eyebrow">Regenerant Catalunya Maps</p>
      <h1 class="display">Programs and Initiatives</h1>
      <p class="lede">
        Regenerative programs, networks, and collective initiatives operating across Catalunya.
      </p>
    </div>
  </header>

  <section class="section section--wide">
    {error && (
      <div class="error-banner">
        <p><strong>Data error:</strong> {error}</p>
      </div>
    )}

    <p class="count">{programs.length} programs mapped</p>

    <div class="item-grid">
      {programs.map((program) => (
        <article class="item-card">
          <div class="item-card__header">
            <h3 class="item-name">{program.name}</h3>
            {program.agency && <span class="item-type">{program.agency}</span>}
          </div>

          <p class="item-description">
            {program.description || program.whatItIs || "No description available."}
          </p>

          {program.area2.length > 0 && (
            <div class="item-badges">
              {program.area2.map((area) => (
                <span class="territory-badge">{area}</span>
              ))}
            </div>
          )}

          {program.website && (
            <a
              href={program.website}
              target="_blank"
              rel="noopener noreferrer"
              class="item-link"
            >
              Website →
            </a>
          )}
        </article>
      ))}
    </div>
  </section>
</Layout>

<style>
  .hero--compact {
    padding: var(--space-12) var(--gutter) var(--space-8);
    border-bottom: 1px solid var(--ink);
    background: var(--paper);
  }
  .hero__inner {
    max-width: var(--container-default);
    margin: 0 auto;
  }
  .hero--compact .eyebrow {
    margin-bottom: var(--space-3);
  }
  .hero--compact h1 {
    margin-bottom: var(--space-4);
  }
  .hero--compact .lede {
    max-width: 70ch;
  }

  .count {
    font-family: var(--mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin: 0 0 var(--space-6);
  }

  .item-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(28rem, 1fr));
    gap: var(--space-4);
  }

  .item-card {
    background: var(--surface-1);
    border: 1px solid var(--border-subtle);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    transition: border-color var(--t-fast);
  }
  .item-card:hover {
    border-color: var(--ink);
  }

  .item-card__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .item-name {
    font-family: var(--serif);
    font-size: 1.2rem;
    font-weight: 500;
    margin: 0;
    color: var(--ink);
    letter-spacing: -0.01em;
  }
  .item-type {
    font-family: var(--mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.2rem 0.5rem;
    background: var(--surface-2);
    color: var(--text-muted);
    border: 1px solid var(--border-subtle);
    white-space: nowrap;
  }
  .item-description {
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--text-muted);
    margin: 0;
  }

  .item-badges {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .territory-badge {
    font-family: var(--mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.15rem 0.4rem;
    background: var(--surface-2);
    color: var(--text-muted);
    border: 1px solid var(--border-subtle);
  }

  .item-link {
    font-family: var(--mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--primary);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color var(--t-fast);
    align-self: flex-start;
    margin-top: var(--space-1);
  }
  .item-link:hover {
    border-bottom-color: var(--primary);
  }

  .error-banner {
    background: var(--surface-2);
    border: 1px solid var(--primary);
    padding: var(--space-4);
    font-family: var(--mono);
    font-size: 0.8rem;
    margin-bottom: var(--space-6);
  }

  @media (max-width: 720px) {
    .item-grid {
      grid-template-columns: 1fr;
    }
    .item-card__header {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
