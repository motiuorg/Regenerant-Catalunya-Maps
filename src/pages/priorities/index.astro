---
import Layout from "../../components/Layout.astro";
import OrganicAmbient from "../../components/OrganicAmbient.astro";
import PriorityCard from "../../components/PriorityCard.astro";
import InterdependenceDiagram from "../../components/InterdependenceDiagram.astro";
import { loadPriorities } from "../../lib/priorities";
import { loadSectionConfig, fetchDatabaseRecords } from "../../lib/notion";
import {
    hasCatbis,
    normalizeRecord,
    normalizeProgram,
    inferPriorityTags,
} from "../../lib/crm";

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;

const priorities = loadPriorities().sort((a, b) => a.order - b.order);

const sections = loadSectionConfig();
const actorsSection = sections.find((s) => s.id === "actors");
const programsSection = sections.find((s) => s.id === "programs");

let actorRecords: any[] = [];
let programRecords: any[] = [];
let notionError: string | null = null;

try {
    if (actorsSection?.database_id) {
        actorRecords = await fetchDatabaseRecords(actorsSection.database_id);
    }
    if (programsSection?.database_id) {
        programRecords = await fetchDatabaseRecords(
            programsSection.database_id,
        );
    }
} catch (e: any) {
    notionError = e.message ?? "Failed to fetch records from Notion.";
}

const actors = actorRecords.filter(hasCatbis).map(normalizeRecord);
const programs = programRecords
    .filter(hasCatbis)
    .map(normalizeProgram)
    .map((p) => ({ ...p, priorityTags: inferPriorityTags(p) }));

function countsForPriority(priorityId: string) {
    return {
        actors: actors.filter((a) => a.thirdTags.includes(priorityId)).length,
        programs: programs.filter((p) => p.priorityTags.includes(priorityId))
            .length,
    };
}

const t = (obj: { en: string }) => obj.en;

// Content dictionary for the i18n engine: priority names/one-liners, indicator
// labels, and default capital rationales, merged with the shared UI strings.
const contentDict: Record<string, { en: string; ca?: string; es?: string }> =
    {};
for (const p of priorities) {
    contentDict[`p-${p.slug}-name`] = p.name;
    contentDict[`p-${p.slug}-shortname`] = p.shortName;
    contentDict[`p-${p.slug}-oneliner`] = p.oneLiner || { en: "" };
}
---

<Layout
    title="Priorities"
    current="priorities"
    description="Six priorities for a living Catalunya: diagnosis, leverage, and capital."
    i18nDict={contentDict}
>
    <header class="hero hero--compact">
        <OrganicAmbient />
        <div class="hero__inner section">
            <p class="eyebrow">Regenerant Catalunya Maps</p>
            <h1 class="display" data-i18n="pri.heroTitle">
                Six priorities for a living Catalunya
            </h1>
            <p class="lede" data-i18n="pri.heroLede">
                A diagnosis of the bioregion across six interdependent systems,
                plus the leverage and capital vehicles that can move each toward
                regeneration.
            </p>
        </div>
    </header>

    <section class="section section--wide">
        {notionError && (
            <div class="error-banner">
                <p>
                    <strong>Data error:</strong> {notionError}
                </p>
            </div>
        )}

        <div class="content-block" data-audience-block="public">
            <p class="content-block__text" data-i18n-html="pri.block.public">
                This section shows where Catalunya is living beyond its limits,
                and what is already being done about it. This temporary,
                evolving categorization of the six priorities takes as its main
                reference the report{" "}
                <a href="https://degrowth.org/wp-content/uploads/2024/07/decreixement_ENG_3.pdf">
                    Ecosocial Transition in Catalonia. A Degrowth Proposal
                </a>{" "}
                by <a href="https://degrowth.org/">Research &amp; Degrowth</a> —
                a solid analysis we align with, though it is just one of many
                possible ways of dividing entities into groups.
            </p>
        </div>

        <h2 class="section-title" data-i18n="pri.six">
            The six priorities
        </h2>
        <div class="priority-grid">
            {priorities.map((priority) => {
                const counts = countsForPriority(priority.id);
                return (
                    <PriorityCard
                        priority={priority}
                        href={`${base}priorities/${priority.slug}/`}
                        actorCount={counts.actors}
                        programCount={counts.programs}
                    />
                );
            })}
        </div>
    </section>

    <section class="section section--wide section--alt">
        <div class="split-panel">
            <div class="split-panel__text">
                <h2 class="section-title" data-i18n="pri.interdependence">
                    Interdependence
                </h2>
                <p class="lede" data-i18n="pri.interdependenceLede">
                    The six priorities are not a menu. They are a system:
                    restoring watersheds increases food resilience; reducing
                    energy demand lowers pressure on water; social commons
                    create the capacity to act across all of them.
                </p>
            </div>
            <div class="split-panel__media">
                <InterdependenceDiagram priorities={priorities} />
            </div>
        </div>
    </section>
</Layout>

<style>
    .hero--compact {
        position: relative;
        padding: var(--space-12) var(--gutter) var(--space-8);
        border-bottom: 1px solid var(--ink);
        background: var(--paper);
        overflow: hidden;
    }
    .hero__inner {
        position: relative;
        z-index: 1;
        max-width: var(--container-default);
        margin: 0 auto;
    }
    .hero--compact .eyebrow {
        margin-bottom: var(--space-3);
    }
    .hero--compact h1 {
        margin-bottom: var(--space-4);
    }
    .hero--compact .lede {
        max-width: 70ch;
    }

    .section-title {
        font-family: var(--serif);
        font-size: 1.6rem;
        font-weight: 500;
        margin: var(--space-10) 0 var(--space-4);
        color: var(--ink);
    }
    .section--alt {
        background: var(--surface-1);
        border-top: 1px solid var(--ink);
        border-bottom: 1px solid var(--ink);
    }
    .section--alt .section-title {
        margin-top: 0;
    }
    .section-lede {
        font-size: 1.05rem;
        line-height: 1.55;
        color: var(--text-muted);
        max-width: 70ch;
        margin: 0 0 var(--space-6);
    }
    .section-body {
        font-size: 0.95rem;
        line-height: 1.55;
        color: var(--text-muted);
        max-width: 70ch;
    }

    .content-block {
        background: var(--surface-1);
        border: 1px solid var(--border-subtle);
        padding: var(--space-5);
        margin-bottom: var(--space-8);
    }
    .content-block__text {
        margin: 0;
        font-size: 1rem;
        line-height: 1.55;
        color: var(--text-primary);
    }

    .priority-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(22rem, 1fr));
        gap: var(--space-4);
    }

    .split-panel {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--space-10);
        align-items: center;
    }
    .split-panel__text {
        max-width: 55ch;
    }
    .split-panel__media {
        display: flex;
        justify-content: center;
    }

    .audience-block {
        margin-bottom: var(--space-6);
    }
    .audience-block__text {
        margin: 0;
        font-size: 0.95rem;
        line-height: 1.55;
        color: var(--text-muted);
        max-width: 70ch;
    }

    .error-banner {
        background: var(--surface-2);
        border: 1px solid var(--primary);
        padding: var(--space-4);
        font-family: var(--mono);
        font-size: 0.8rem;
        margin-bottom: var(--space-6);
    }

    @media (max-width: 1024px) {
        .split-panel {
            grid-template-columns: 1fr;
        }
    }
    @media (max-width: 720px) {
        .priority-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
