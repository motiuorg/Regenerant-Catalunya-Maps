---
import Layout from "../../components/Layout.astro";
import OrganicAmbient from "../../components/OrganicAmbient.astro";
import { loadSectionConfig, fetchDatabaseRecords } from "../../lib/notion";
import {
  hasCatbis,
  hasFluvia,
  normalizeRecord,
  uniqueValues,
  priorityAreaOptions,
  territoryOptions,
  priorityColor,
} from "../../lib/crm";
import type { CrmActor } from "../../lib/crm";
import { loadFluviaContent, fluviaDict, t } from "../../lib/fluvia";

const content = loadFluviaContent();
const dict = fluviaDict();

const sections = loadSectionConfig();
const actorsSection = sections.find((s) => s.id === "actors");

let records: any[] = [];
let error: string | null = null;
if (actorsSection?.database_id) {
  try {
    records = await fetchDatabaseRecords(actorsSection.database_id);
  } catch (e: any) {
    error = e.message ?? "Failed to fetch actors from Notion.";
  }
} else {
  error = "No database_id configured for actors section.";
}

const actors: CrmActor[] = records
  .filter((r) => hasCatbis(r) && hasFluvia(r))
  .map(normalizeRecord);

const activePriorityAreas = priorityAreaOptions.filter((p) =>
  actors.some((a) => a.thirdTags.includes(p))
);
const activeTerritories = territoryOptions.filter((ter) =>
  actors.some((a) => a.area2.includes(ter))
);
const actorRoles = uniqueValues(actors, "actorRoles").filter(Boolean);

const safeJson = (obj: any) =>
  JSON.stringify(obj)
    .replace(/</g, "\\u003c")
    .replace(/>/g, "\\u003e")
    .replace(/&/g, "\\u0026");
---

<Layout
  title="Organizations on the Fluvià"
  description="Organizations, public bodies, networks and citizen platforms regenerating the Fluvià watershed."
  current="organizations"
  shell="fluvia"
  noindex
  i18nDict={dict}
>
  <header class="hero hero--compact">
    <OrganicAmbient />
    <div class="hero__inner section">
      <p class="eyebrow" data-i18n="fluv.home.eyebrow">Regenerant Catalunya Maps · Fluvià watershed</p>
      <h1 class="display" data-i18n="nav.organizations">Organizations</h1>
      <p class="lede" data-i18n="fluv.orgs.heroLede">
        The stewards of the basin: non-profits, public bodies, networks and citizen platforms.
        Search by name or filter by priority, territory and role.
      </p>
    </div>
  </header>

  <section class="section section--wide">
    {error && (
      <div class="error-banner">
        <p><strong data-i18n="common.dataError">Data error:</strong> {error}</p>
      </div>
    )}

    <div class="filter-panel">
      <div class="filter-panel__header">
        <h2 class="filter-panel__title" data-i18n="common.filters">Filters</h2>
        <button type="button" class="filter-clear" id="clear-filters" data-i18n="common.clearAll">Clear all</button>
      </div>

      <div class="filter-search">
        <label class="filter-label" for="search-input" data-i18n="common.searchByName">Search by name</label>
        <input
          type="search"
          id="search-input"
          class="search-input"
          placeholder="Type an organization name…"
          data-i18n-placeholder="orgs.searchPlaceholder"
          autocomplete="off"
        />
      </div>

      <div class="filter-grid">
        <fieldset class="filter-group">
          <legend class="filter-label" data-i18n="common.priorityArea">Priority area</legend>
          <div class="filter-buttons" id="priority-filters">
            {activePriorityAreas.map((tag) => (
              <button
                type="button"
                class="filter-btn"
                data-filter-value={tag}
                style={`--filter-color: ${priorityColor(tag)}`}
                aria-pressed="false"
              >
                {tag}
              </button>
            ))}
          </div>
        </fieldset>

        <fieldset class="filter-group">
          <legend class="filter-label" data-i18n="common.territory">Territory</legend>
          <div class="checkbox-list" id="territory-filters">
            {activeTerritories.map((tag) => (
              <label class="checkbox-item">
                <input type="checkbox" value={tag} />
                <span>{tag}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <fieldset class="filter-group">
          <legend class="filter-label" data-i18n="fluv.orgs.role">Role in the ecosystem</legend>
          <div class="checkbox-list" id="role-filters">
            {actorRoles.map((role) => (
              <label class="checkbox-item">
                <input type="checkbox" value={role} />
                <span>{role}</span>
              </label>
            ))}
          </div>
        </fieldset>
      </div>
    </div>

    <p class="count" id="gallery-count" data-i18n="common.loading">Loading…</p>

    <div class="actor-grid" id="actor-gallery">
      {actors.map((actor) => (
        <article class="actor-card" data-actor={safeJson(actor)}>
          <div class="actor-card__main">
            <div class="actor-card__header">
              <h3 class="actor-name">{actor.name}</h3>
              {actor.actorType && <span class="actor-type">{actor.actorType}</span>}
            </div>

            <p class="actor-description">
              {actor.description || actor.whyItMatters || <span data-i18n="common.noDescription">No description available.</span>}
            </p>

            <div class="actor-badges">
              {actor.thirdTags.map((tag) => (
                <span
                  class="priority-badge"
                  style={`--badge-color: ${priorityColor(tag)}`}
                >
                  {tag}
                </span>
              ))}
              {actor.area2.map((area) => (
                <span class="territory-badge">{area}</span>
              ))}
            </div>

            <div class="actor-actions">
              {actor.website && (
                <a
                  href={actor.website}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="actor-link"
                >
                  <span data-i18n="common.website">Website →</span>
                </a>
              )}
              <button type="button" class="details-toggle">
                <span data-i18n="common.details">Details</span>
              </button>
            </div>
          </div>

          <div class="actor-card__details" hidden>
            {actor.whyItMatters && (
              <div class="detail-block">
                <h4 data-i18n="fluv.orgs.why">Why it matters on the Fluvià</h4>
                <p>{actor.whyItMatters}</p>
              </div>
            )}
            {actor.actorRoles.length > 0 && (
              <div class="detail-block">
                <h4 data-i18n="fluv.orgs.role">Role in the ecosystem</h4>
                <ul>
                  {actor.actorRoles.map((role) => <li>{role}</li>)}
                </ul>
              </div>
            )}
            {actor.themes.length > 0 && (
              <div class="detail-block">
                <h4>Memes</h4>
                <div class="detail-tags">
                  {actor.themes.map((theme) => <span class="detail-tag">{theme}</span>)}
                </div>
              </div>
            )}
            {actor.publicEmail && (
              <div class="detail-block">
                <h4>Contact</h4>
                <p><a href={`mailto:${actor.publicEmail}`}>{actor.publicEmail}</a></p>
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <script is:inline>
    (function () {
      const cards = Array.from(document.querySelectorAll(".actor-card"));
      const actors = cards.map((el) => JSON.parse(el.dataset.actor || "{}"));
      const countLabel = document.getElementById("gallery-count");
      const searchInput = document.getElementById("search-input");
      const clearBtn = document.getElementById("clear-filters");

      const filters = {
        thirdTags: [],
        area2: [],
        actorRoles: [],
        search: "",
      };

      function normalize(str) {
        return String(str || "").toLowerCase().normalize("NFD").replace(/\p{Diacritic}/gu, "");
      }

      function matches(actor, key, values) {
        if (values.length === 0) return true;
        const actorValues = actor[key] || [];
        return values.some((v) => actorValues.includes(v));
      }

      function matchesSearch(actor) {
        const term = normalize(filters.search).trim();
        if (!term) return true;
        const haystack = normalize([actor.name, actor.description, actor.whyItMatters].join(" "));
        return haystack.includes(term);
      }

      function isVisible(actor) {
        return (
          matchesSearch(actor) &&
          matches(actor, "thirdTags", filters.thirdTags) &&
          matches(actor, "area2", filters.area2) &&
          matches(actor, "actorRoles", filters.actorRoles)
        );
      }

      function updateGallery() {
        let visible = 0;
        for (let i = 0; i < actors.length; i++) {
          const show = isVisible(actors[i]);
          cards[i].classList.toggle("is-hidden", !show);
          if (show) visible++;
        }
        if (countLabel) {
          countLabel.textContent = window.rc2I18n
            ? window.rc2I18n.t("orgs.count", { shown: visible, total: actors.length })
            : `Showing ${visible} of ${actors.length} organizations`;
        }
      }

      function bindButtonGroup(containerId, key) {
        document.querySelectorAll(`#${containerId} .filter-btn`).forEach((btn) => {
          btn.addEventListener("click", () => {
            const value = btn.dataset.filterValue;
            const active = btn.classList.toggle("active");
            btn.setAttribute("aria-pressed", String(active));
            if (active) {
              filters[key].push(value);
            } else {
              filters[key] = filters[key].filter((v) => v !== value);
            }
            updateGallery();
          });
        });
      }

      function bindCheckboxGroup(containerId, key) {
        document.querySelectorAll(`#${containerId} input[type='checkbox']`).forEach((input) => {
          input.addEventListener("change", () => {
            filters[key] = Array.from(
              document.querySelectorAll(`#${containerId} input[type='checkbox']:checked`)
            ).map((el) => el.value);
            updateGallery();
          });
        });
      }

      bindButtonGroup("priority-filters", "thirdTags");
      bindCheckboxGroup("territory-filters", "area2");
      bindCheckboxGroup("role-filters", "actorRoles");

      if (searchInput) {
        searchInput.addEventListener("input", () => {
          filters.search = searchInput.value;
          updateGallery();
        });
      }

      if (clearBtn) {
        clearBtn.addEventListener("click", () => {
          filters.thirdTags = [];
          filters.area2 = [];
          filters.actorRoles = [];
          filters.search = "";
          if (searchInput) searchInput.value = "";
          document.querySelectorAll(".filter-btn.active").forEach((btn) => {
            btn.classList.remove("active");
            btn.setAttribute("aria-pressed", "false");
          });
          document.querySelectorAll(".checkbox-list input[type='checkbox']").forEach((input) => {
            input.checked = false;
          });
          updateGallery();
        });
      }

      // Details toggle lives inside each card; keep the label translatable.
      document.querySelectorAll(".details-toggle").forEach((btn) => {
        btn.addEventListener("click", () => {
          const card = btn.closest(".actor-card");
          const details = card && card.querySelector(".actor-card__details");
          if (!details) return;
          const willShow = details.hasAttribute("hidden");
          details.toggleAttribute("hidden", !willShow);
          const label = willShow
            ? (window.rc2I18n && window.rc2I18n.t("common.hideDetails")) || "Hide details"
            : (window.rc2I18n && window.rc2I18n.t("common.details")) || "Details";
          btn.textContent = label;
        });
      });

      updateGallery();
    })();
  </script>
</Layout>

<style>
  .hero--compact {
    position: relative;
    padding: var(--space-12) var(--gutter) var(--space-8);
    border-bottom: 1px solid var(--ink);
    background: var(--paper);
    overflow: hidden;
  }
  .hero__inner { position: relative; z-index: 1; max-width: var(--container-default); margin: 0 auto; }
  .hero--compact .eyebrow { margin-bottom: var(--space-3); }
  .hero--compact h1 { margin-bottom: var(--space-4); }
  .hero--compact .lede { max-width: 70ch; }

  .filter-panel {
    background: var(--surface-1);
    border: 1px solid var(--border-subtle);
    padding: var(--space-6);
    margin-bottom: var(--space-6);
  }
  .filter-panel__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--border-subtle);
  }
  .filter-panel__title {
    font-family: var(--serif);
    font-size: 1.1rem;
    font-weight: 500;
    margin: 0;
  }
  .filter-clear {
    font-family: var(--mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: var(--space-2) var(--space-3);
    background: transparent;
    color: var(--primary);
    border: 1px solid var(--border-subtle);
    cursor: pointer;
    transition: background-color var(--t-fast), border-color var(--t-fast);
  }
  .filter-clear:hover { background: var(--surface-2); border-color: var(--primary); }
  .filter-search { margin-bottom: var(--space-5); }
  .filter-search .filter-label { display: block; margin-bottom: var(--space-2); }
  .search-input {
    width: 100%;
    max-width: 40rem;
    padding: var(--space-3) var(--space-4);
    font-family: var(--sans);
    font-size: var(--text-base);
    color: var(--text-primary);
    background: var(--paper);
    border: 1px solid var(--border-subtle);
    outline: none;
    transition: border-color var(--t-fast);
  }
  .search-input:focus { border-color: var(--primary); }
  .filter-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-6);
  }
  .filter-group { margin: 0; padding: 0; border: none; min-width: 0; }
  .filter-label {
    display: block;
    font-family: var(--mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    margin-bottom: var(--space-2);
  }
  .filter-buttons { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .filter-btn {
    font-family: var(--mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: var(--space-2) var(--space-3);
    background: var(--paper);
    color: var(--text-primary);
    border: 1px solid var(--border-subtle);
    cursor: pointer;
    transition: background-color var(--t-fast), color var(--t-fast), border-color var(--t-fast);
  }
  .filter-btn:hover { border-color: var(--ink); }
  .filter-btn.active {
    background: color-mix(in srgb, var(--filter-color, var(--primary)) 14%, var(--surface-1));
    color: var(--filter-color, var(--primary));
    border-color: var(--filter-color, var(--primary));
  }
  .checkbox-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    max-height: 12rem;
    overflow-y: auto;
    padding: var(--space-2);
    background: var(--paper);
    border: 1px solid var(--border-subtle);
  }
  .checkbox-item {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--sans);
    font-size: 0.85rem;
    color: var(--text-primary);
    cursor: pointer;
  }
  .checkbox-item input { cursor: pointer; }

  .count {
    font-family: var(--mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin: 0 0 var(--space-6);
  }

  .actor-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(24rem, 1fr));
    gap: var(--space-4);
  }
  .actor-card {
    background: var(--surface-1);
    border: 1px solid var(--border-subtle);
    display: flex;
    flex-direction: column;
    transition: border-color var(--t-fast);
  }
  .actor-card:hover { border-color: var(--ink); }
  .actor-card.is-hidden { display: none; }
  .actor-card__main {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    flex: 1;
  }
  .actor-card__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .actor-name {
    font-family: var(--serif);
    font-size: 1.2rem;
    font-weight: 500;
    margin: 0;
    color: var(--ink);
    letter-spacing: -0.01em;
  }
  .actor-type {
    font-family: var(--mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.2rem 0.5rem;
    background: var(--surface-2);
    color: var(--text-muted);
    border: 1px solid var(--border-subtle);
    white-space: nowrap;
  }
  .actor-description {
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--text-muted);
    margin: 0;
  }
  .actor-badges { display: flex; gap: 0.4rem; flex-wrap: wrap; }
  .priority-badge {
    font-family: var(--mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.15rem 0.4rem;
    background: color-mix(in srgb, var(--badge-color, var(--ink)) 14%, var(--surface-1));
    color: var(--badge-color, var(--ink));
    border: 1px solid var(--badge-color, var(--ink));
  }
  .territory-badge {
    font-family: var(--mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.15rem 0.4rem;
    background: var(--surface-2);
    color: var(--text-muted);
    border: 1px solid var(--border-subtle);
  }
  .actor-actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-1);
  }
  .actor-link {
    font-family: var(--mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--primary);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color var(--t-fast);
  }
  .actor-link:hover { border-bottom-color: var(--primary); }
  .details-toggle {
    font-family: var(--mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    background: transparent;
    border: none;
    border-bottom: 1px solid transparent;
    cursor: pointer;
    padding: 0;
    transition: color var(--t-fast), border-color var(--t-fast);
  }
  .details-toggle:hover { color: var(--ink); border-bottom-color: var(--ink); }
  .actor-card__details {
    border-top: 1px dashed var(--border-subtle);
    padding: var(--space-5) var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .actor-card__details[hidden] { display: none; }
  .detail-block h4 {
    font-family: var(--mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin: 0 0 var(--space-2);
    font-weight: 400;
  }
  .detail-block p, .detail-block ul {
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--text-primary);
    margin: 0;
  }
  .detail-block ul { list-style: none; padding: 0; display: flex; flex-direction: column; gap: var(--space-1); }
  .detail-block a { color: var(--primary); }
  .detail-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .detail-tag {
    font-family: var(--mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.15rem 0.4rem;
    background: var(--surface-2);
    color: var(--text-muted);
    border: 1px solid var(--border-subtle);
  }

  .error-banner {
    background: var(--surface-2);
    border: 1px solid var(--primary);
    padding: var(--space-4);
    font-family: var(--mono);
    font-size: 0.8rem;
    margin-bottom: var(--space-6);
  }

  @media (max-width: 720px) {
    .filter-grid { grid-template-columns: 1fr; }
    .actor-grid { grid-template-columns: 1fr; }
    .actor-card__header { flex-direction: column; align-items: flex-start; }
  }
</style>
