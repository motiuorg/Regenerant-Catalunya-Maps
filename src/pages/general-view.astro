---
import Layout from "../components/Layout.astro";
import { loadSectionConfig, fetchDatabaseRecords } from "../lib/notion";
import {
  normalizeRecord,
  hasCatbis,
  uniqueValues,
  priorityAreaOptions,
  territoryOptions,
  priorityColor,
} from "../lib/crm";
import type { CrmActor } from "../lib/crm";

const sections = loadSectionConfig();
const actorsSection = sections.find((s) => s.id === "actors");

let records: any[] = [];
let error: string | null = null;
if (actorsSection?.database_id) {
  try {
    records = await fetchDatabaseRecords(actorsSection.database_id);
  } catch (e: any) {
    error = e.message ?? "Failed to fetch actors from Notion.";
  }
} else {
  error = "No database_id configured for actors section.";
}

const actors: CrmActor[] = records.filter(hasCatbis).map(normalizeRecord);

const activePriorityAreas = priorityAreaOptions.filter((p) =>
  actors.some((a) => a.thirdTags.includes(p))
);
const activeTerritories = territoryOptions.filter((t) =>
  actors.some((a) => a.area2.includes(t))
);
const themes = uniqueValues(actors, "themes");

const safeJson = (obj: any) =>
  JSON.stringify(obj)
    .replace(/</g, "\\u003c")
    .replace(/>/g, "\\u003e")
    .replace(/&/g, "\\u0026");
---

<Layout title="General View" current="general-view">
  <header class="hero hero--compact">
    <div class="hero__inner section">
      <p class="eyebrow">Regenerant Catalunya Maps</p>
      <h1 class="display">Explore the ecosystem</h1>
      <p class="lede">
        Discover regenerative projects, initiatives, organizations, and networks across
        Catalunya. Filter by priority area and territory to find actors contributing to
        regenerative futures.
      </p>
    </div>
  </header>

  <section class="section section--wide">
    {error && (
      <div class="error-banner">
        <p><strong>Data error:</strong> {error}</p>
      </div>
    )}

    <div class="filter-bar">
      <div class="filter-group">
        <span class="filter-label">Priority area</span>
        <div class="filter-buttons" id="priority-filters">
          {activePriorityAreas.map((tag) => (
            <button
              type="button"
              class="filter-btn"
              data-filter-value={tag}
              style={`--filter-color: ${priorityColor(tag)}`}
              aria-pressed="false"
            >
              {tag}
            </button>
          ))}
        </div>
      </div>

      <div class="filter-group filter-group--wide">
        <span class="filter-label">Territory</span>
        <div class="checkbox-list" id="territory-filters">
          {activeTerritories.map((tag) => (
            <label class="checkbox-item">
              <input type="checkbox" value={tag} />
              <span>{tag}</span>
            </label>
          ))}
        </div>
      </div>
    </div>

    <p class="count" id="gallery-count">Loading…</p>

    <div class="actor-grid" id="actor-gallery">
      {actors.map((actor) => (
        <article class="actor-card" data-actor={safeJson(actor)}>
          <div class="actor-card__main">
            <div class="actor-card__header">
              <h3 class="actor-name">{actor.name}</h3>
              {actor.actorType && <span class="actor-type">{actor.actorType}</span>}
            </div>

            <p class="actor-description">
              {actor.description || actor.whyItMatters || "No description available."}
            </p>

            <div class="actor-badges">
              {actor.thirdTags.map((tag) => (
                <span
                  class="priority-badge"
                  style={`--badge-color: ${priorityColor(tag)}`}
                >
                  {tag}
                </span>
              ))}
              {actor.area2.map((area) => (
                <span class="territory-badge">{area}</span>
              ))}
            </div>

            <div class="actor-actions">
              {actor.website && (
                <a
                  href={actor.website}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="actor-link"
                >
                  Website →
                </a>
              )}
              <button type="button" class="details-toggle" data-details-toggle>
                Details
              </button>
            </div>
          </div>

          <div class="actor-card__details" hidden>
            {actor.whyItMatters && (
              <div class="detail-block">
                <h4>Why it matters</h4>
                <p>{actor.whyItMatters}</p>
              </div>
            )}

            {actor.publicEmail && (
              <div class="detail-block">
                <h4>Public contact</h4>
                <a href={`mailto:${actor.publicEmail}`} class="actor-link">
                  {actor.publicEmail}
                </a>
              </div>
            )}

            {actor.linkedin && (
              <div class="detail-block">
                <h4>LinkedIn</h4>
                <a
                  href={actor.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="actor-link"
                >
                  {actor.linkedin}
                </a>
              </div>
            )}

            {actor.climateZone && (
              <div class="detail-block">
                <h4>Climate context</h4>
                <p>{actor.climateZone}</p>
              </div>
            )}

            {actor.themes.length > 0 && (
              <div class="detail-block">
                <h4>Themes</h4>
                <div class="detail-tags">
                  {actor.themes.map((t) => <span class="detail-tag">{t}</span>)}
                </div>
              </div>
            )}

            {actor.relatedInitiatives.length > 0 && (
              <div class="detail-block">
                <h4>Related initiatives</h4>
                <ul>
                  {actor.relatedInitiatives.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            )}

            {actor.relatedProjects.length > 0 && (
              <div class="detail-block">
                <h4>Related projects or areas</h4>
                <ul>
                  {actor.relatedProjects.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            )}

            {actor.relatedEvents.length > 0 && (
              <div class="detail-block">
                <h4>Related events</h4>
                <ul>
                  {actor.relatedEvents.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            )}

            {actor.relatedResources.length > 0 && (
              <div class="detail-block">
                <h4>Related resources</h4>
                <ul>
                  {actor.relatedResources.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <script is:inline>
    (function () {
      const cards = Array.from(document.querySelectorAll(".actor-card"));
      const actors = cards.map((el) => JSON.parse(el.dataset.actor || "{}"));
      const countLabel = document.getElementById("gallery-count");

      const filters = {
        thirdTags: [],
        area2: [],
      };

      function matches(actor, key, values) {
        if (values.length === 0) return true;
        const actorValues = actor[key] || [];
        return values.some((v) => actorValues.includes(v));
      }

      function isVisible(actor) {
        return (
          matches(actor, "thirdTags", filters.thirdTags) &&
          matches(actor, "area2", filters.area2)
        );
      }

      function updateGallery() {
        let visible = 0;
        for (let i = 0; i < actors.length; i++) {
          const show = isVisible(actors[i]);
          cards[i].classList.toggle("is-hidden", !show);
          if (show) visible++;
        }
        if (countLabel) {
          countLabel.textContent = `Showing ${visible} of ${actors.length} initiatives`;
        }
      }

      document.querySelectorAll("#priority-filters .filter-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          const value = btn.dataset.filterValue;
          const active = btn.classList.toggle("active");
          btn.setAttribute("aria-pressed", String(active));
          if (active) {
            filters.thirdTags.push(value);
          } else {
            filters.thirdTags = filters.thirdTags.filter((v) => v !== value);
          }
          updateGallery();
        });
      });

      document.querySelectorAll("#territory-filters input[type='checkbox']").forEach((input) => {
        input.addEventListener("change", () => {
          filters.area2 = Array.from(
            document.querySelectorAll("#territory-filters input[type='checkbox']:checked")
          ).map((el) => el.value);
          updateGallery();
        });
      });

      document.querySelectorAll("[data-details-toggle]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const card = btn.closest(".actor-card");
          const details = card.querySelector(".actor-card__details");
          const hidden = details.hidden;
          details.hidden = !hidden;
          btn.textContent = hidden ? "Hide details" : "Details";
        });
      });

      updateGallery();
    })();
  </script>
</Layout>

<style>
  .hero--compact {
    padding: var(--space-12) var(--gutter) var(--space-8);
    border-bottom: 1px solid var(--ink);
    background: var(--paper);
  }
  .hero__inner {
    max-width: var(--container-default);
    margin: 0 auto;
  }
  .hero--compact .eyebrow {
    margin-bottom: var(--space-3);
  }
  .hero--compact h1 {
    margin-bottom: var(--space-4);
  }
  .hero--compact .lede {
    max-width: 70ch;
  }

  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    margin-bottom: var(--space-4);
  }
  .filter-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .filter-group--wide {
    flex: 1 1 18rem;
    max-width: 28rem;
  }
  .filter-label {
    font-family: var(--mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
  }
  .filter-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .filter-btn {
    font-family: var(--mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: var(--space-2) var(--space-3);
    background: var(--surface-1);
    color: var(--text-primary);
    border: 1px solid var(--border-subtle);
    cursor: pointer;
    transition: background-color var(--t-fast), color var(--t-fast), border-color var(--t-fast);
  }
  .filter-btn:hover {
    border-color: var(--ink);
  }
  .filter-btn.active {
    background: color-mix(in srgb, var(--filter-color, var(--ink)) 14%, var(--surface-1));
    color: var(--filter-color, var(--ink));
    border-color: var(--filter-color, var(--ink));
  }

  .checkbox-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    max-height: 14rem;
    overflow-y: auto;
    padding: var(--space-2);
    background: var(--surface-1);
    border: 1px solid var(--border-subtle);
    min-width: 14rem;
    max-width: 100%;
  }
  .checkbox-item {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--sans);
    font-size: 0.85rem;
    color: var(--text-primary);
    cursor: pointer;
  }
  .checkbox-item input {
    cursor: pointer;
  }

  .count {
    font-family: var(--mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin: 0 0 var(--space-6);
  }

  .actor-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(28rem, 1fr));
    gap: var(--space-4);
  }

  .actor-card {
    background: var(--surface-1);
    border: 1px solid var(--border-subtle);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    transition: border-color var(--t-fast);
  }
  .actor-card:hover {
    border-color: var(--ink);
  }
  .actor-card.is-hidden {
    display: none;
  }

  .actor-card__main {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .actor-card__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .actor-name {
    font-family: var(--serif);
    font-size: 1.2rem;
    font-weight: 500;
    margin: 0;
    color: var(--ink);
    letter-spacing: -0.01em;
  }
  .actor-type {
    font-family: var(--mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.2rem 0.5rem;
    background: var(--surface-2);
    color: var(--text-muted);
    border: 1px solid var(--border-subtle);
    white-space: nowrap;
  }
  .actor-description {
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--text-muted);
    margin: 0;
  }

  .actor-badges {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .priority-badge {
    font-family: var(--mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.15rem 0.4rem;
    background: color-mix(in srgb, var(--badge-color, var(--ink)) 14%, var(--surface-1));
    color: var(--badge-color, var(--ink));
    border: 1px solid var(--badge-color, var(--ink));
  }
  .territory-badge {
    font-family: var(--mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.15rem 0.4rem;
    background: var(--surface-2);
    color: var(--text-muted);
    border: 1px solid var(--border-subtle);
  }

  .actor-actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-1);
  }
  .actor-link {
    font-family: var(--mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--primary);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color var(--t-fast);
  }
  .actor-link:hover {
    border-bottom-color: var(--primary);
  }
  .details-toggle {
    font-family: var(--mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.25rem 0.75rem;
    background: var(--surface-2);
    color: var(--text-primary);
    border: 1px solid var(--border-subtle);
    cursor: pointer;
    transition: background-color var(--t-fast), border-color var(--t-fast);
  }
  .details-toggle:hover {
    background: var(--paper);
    border-color: var(--ink);
  }

  .actor-card__details {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px dashed var(--border-subtle);
  }
  .actor-card__details[hidden] {
    display: none;
  }
  .detail-block h4 {
    font-family: var(--mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin: 0 0 var(--space-1);
  }
  .detail-block p,
  .detail-block ul {
    font-size: 0.88rem;
    color: var(--text-primary);
    margin: 0;
    line-height: 1.55;
  }
  .detail-block ul {
    padding-left: 1.2rem;
  }
  .detail-block li {
    margin-bottom: 0.25rem;
  }
  .detail-tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .detail-tag {
    font-family: var(--mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.15rem 0.4rem;
    background: var(--surface-2);
    color: var(--text-muted);
  }

  .error-banner {
    background: var(--surface-2);
    border: 1px solid var(--primary);
    padding: var(--space-4);
    font-family: var(--mono);
    font-size: 0.8rem;
    margin-bottom: var(--space-6);
  }

  @media (max-width: 720px) {
    .actor-grid {
      grid-template-columns: 1fr;
    }
    .actor-card__header {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
