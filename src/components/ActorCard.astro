---
import type { CrmActor } from "../lib/crm";

export interface Props {
  actor: CrmActor;
  priorityColors?: Record<string, string>;
}
const { actor, priorityColors = {} } = Astro.props;

const description = actor.description.slice(0, 280);
---

<article class="actor-card">
  <div class="actor-card__header">
    <h3 class="actor-name">{actor.name}</h3>
    <div class="actor-meta">
      {actor.agency.map((a) => (
        <span class="badge badge--agency">{a}</span>
      ))}
      {actor.area2.map((a) => (
        <span class="badge badge--area">{a}</span>
      ))}
    </div>
    {actor.thirdTags.length > 0 && (
      <div class="actor-priorities">
        {actor.thirdTags.map((tag) => (
          <span
            class="priority-badge"
            style={priorityColors[tag] ? `--badge-color: ${priorityColors[tag]}` : undefined}
          >
            {tag}
          </span>
        ))}
      </div>
    )}
  </div>

  <div class="actor-tags">
    {actor.ontologyTags.map((t) => <span class="tag">{t}</span>)}
    {actor.memes.map((t) => <span class="tag tag--meme">{t}</span>)}
  </div>

  <p class="actor-desc">{description || "No description available."}</p>

  <div class="actor-links">
    {actor.website && (
      <a href={actor.website} target="_blank" rel="noopener noreferrer" class="link-website">
        Website →
      </a>
    )}
    {actor.linkedin && (
      <a href={actor.linkedin} target="_blank" rel="noopener noreferrer" class="link-linkedin">
        LinkedIn →
      </a>
    )}
  </div>
</article>

<style>
  .actor-card {
    background: var(--surface-1);
    border: 1px solid var(--border-subtle);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    transition: border-color var(--t-fast);
  }
  .actor-card:hover {
    border-color: var(--ink);
  }
  .actor-card__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .actor-name {
    font-family: var(--serif);
    font-size: 1.15rem;
    font-weight: 500;
    margin: 0;
    color: var(--ink);
    letter-spacing: -0.01em;
  }
  .actor-meta {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .badge {
    font-family: var(--mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--border-subtle);
    color: var(--text-muted);
  }
  .badge--agency {
    background: var(--surface-2);
    color: var(--ink);
    border-color: var(--ink);
  }
  .actor-priorities {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .priority-badge {
    font-family: var(--mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.15rem 0.4rem;
    background: color-mix(in srgb, var(--badge-color, var(--ink)) 14%, var(--surface-1));
    color: var(--badge-color, var(--ink));
    border: 1px solid var(--badge-color, var(--ink));
  }
  .actor-tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .tag {
    font-family: var(--mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.15rem 0.4rem;
    background: var(--surface-2);
    color: var(--text-muted);
  }
  .tag--meme {
    background: var(--primary);
    color: var(--primary-foreground);
  }
  .actor-desc {
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--text-muted);
    margin: 0;
    flex: 1;
  }
  .actor-links {
    display: flex;
    gap: var(--space-4);
    margin-top: var(--space-1);
  }
  .actor-links a {
    font-family: var(--mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--primary);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color var(--t-fast);
  }
  .actor-links a:hover {
    border-bottom-color: var(--primary);
  }
</style>
