---
import fs from "node:fs";
import path from "node:path";
import yaml from "js-yaml";
const site = yaml.load(
  fs.readFileSync(path.join(process.cwd(), "src/data/site.yaml"), "utf8")
) as { name: string };

interface Props {
  current?: string;
  section?: string;
  dataset?: string;
}
const { current = "home", section, dataset } = Astro.props;
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const items = [
  { id: "home", label: "Home", href: base, key: "nav.home" },
  { id: "priorities", label: "Priorities", href: `${base}priorities/`, key: "nav.priorities" },
  { id: "contribute", label: "Contribute", href: `${base}contribute/`, key: "nav.contribute" },
  { id: "bioeconomy", label: "Bioeconomy", href: `${base}bioeconomy/`, key: "nav.bioeconomy" },
  { id: "organizations", label: "Organizations", href: `${base}organizations/`, key: "nav.organizations" },
  { id: "programs", label: "Programs and Initiatives", href: `${base}programs/`, key: "nav.programs" },
  { id: "events", label: "Events", href: `${base}events/`, key: "nav.events" },
];
---
<header class="site-nav">
  <a href={base} class="brand" aria-label={`${site.name} — home`}>
    <span class="brand-org">{site.name}</span>
    {section && <><span class="brand-sep">·</span><span class="brand-system">{section}</span></>}
    {dataset && <><span class="brand-sep">·</span><span class="brand-dataset">{dataset}</span></>}
  </a>
  <nav aria-label="Primary">
    <ul>
      {items.map((it) => (
        <li><a href={it.href} class:list={[{ active: current === it.id }]} data-i18n={it.key}>{it.label}</a></li>
      ))}
      <li class="nav-lang">
        <div class="lang-switcher" role="group" aria-label="Language">
          {["en", "ca", "es"].map((lang) => (
            <button
              type="button"
              class="lang-switcher__btn"
              data-lang-btn={lang}
              lang={lang}
              aria-pressed="false"
            >
              {lang.toUpperCase()}
            </button>
          ))}
        </div>
      </li>
    </ul>
  </nav>
</header>
<style>
.site-nav { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1rem var(--gutter); border-bottom: 1px solid var(--ink); background: var(--paper); position: sticky; top: 0; z-index: 10; }
.brand { display: flex; align-items: baseline; gap: 0.6rem; text-decoration: none; color: var(--ink); font-family: var(--mono); font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.08em; }
.brand-org { font-weight: 500; }
.brand-system, .brand-sep { color: var(--rule); }
.brand-dataset { color: var(--ink); }
nav ul { list-style: none; display: flex; gap: 1.25rem; margin: 0; padding: 0; flex-wrap: wrap; }
nav a { font-family: var(--mono); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--rule); text-decoration: none; padding: 0.25rem 0; border-bottom: 1px solid transparent; white-space: nowrap; }
nav a.active, nav a:hover { color: var(--ink); border-bottom-color: var(--ink); }
.lang-switcher {
  display: inline-flex;
  gap: 0;
  border: 1px solid var(--border-subtle);
}
.lang-switcher__btn {
  font-family: var(--mono);
  font-size: 0.68rem;
  letter-spacing: 0.05em;
  padding: 0.25rem 0.5rem;
  background: var(--paper);
  color: var(--text-muted);
  border: none;
  cursor: pointer;
  transition: background-color var(--t-fast), color var(--t-fast);
}
.lang-switcher__btn + .lang-switcher__btn {
  border-left: 1px solid var(--border-subtle);
}
.lang-switcher__btn:hover {
  color: var(--ink);
}
.lang-switcher__btn.active {
  background: var(--ink);
  color: var(--paper);
}
@media (max-width: 880px) { .brand-system, .brand-sep { display: none; } }
@media (max-width: 720px) { .site-nav { flex-direction: column; align-items: flex-start; } nav ul { gap: 0.9rem; } }
</style>
