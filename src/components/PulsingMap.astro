---
// PulsingMap.astro — decorative living map of the comarques.
// The territory rotates through the six priority colors: every comarca
// cycles the hue wheel at its own speed/direction (chaos), while a 10s
// brightness wave flows across the map (flow) with per-comarca breathing.
// Pure client-side; no libraries; honors prefers-reduced-motion.
import { COMARQUES } from "../data/comarques";
import { loadPriorities } from "../lib/priorities";

const palette = loadPriorities()
    .sort((a, b) => a.order - b.order)
    .map((p) => p.color);
const [vx, vy, vw, vh] = COMARQUES.viewBox;
const paletteJson = JSON.stringify(palette);
---

<div class="pulsing-map" data-palette={paletteJson}>
    <svg
        id="pulsing-map-svg"
        viewBox={`${vx} ${vy} ${vw} ${vh}`}
        preserveAspectRatio="xMidYMid meet"
        role="img"
        aria-label="Living map of the comarques of Catalunya, pulsing with the six priority colors"
    >
        {COMARQUES.comarques.map((c, i) => (
            <path
                class="comarca"
                d={c.paths.join(" ")}
                fill-rule="evenodd"
                fill={palette[i % palette.length]}
                data-flow={((c.cx + c.cy) / 2000).toFixed(4)}
                data-name={c.name}
            >
                <title>{c.name}</title>
            </path>
        ))}
    </svg>
</div>

<script>
    const wrap = document.querySelector(".pulsing-map");
    const svg = document.getElementById("pulsing-map-svg");
    if (!wrap || !svg) throw new Error("pulsing map missing");
    const paths = Array.from(svg.querySelectorAll("path.comarca"));

    const hex = (h) => [
        parseInt(h.slice(1, 3), 16),
        parseInt(h.slice(3, 5), 16),
        parseInt(h.slice(5, 7), 16),
    ];
    const P = JSON.parse(wrap.dataset.palette).map(hex);
    const WHITE = [255, 255, 255];
    const BLACK = [0, 0, 0];
    const hash = (x, s) => {
        const v = Math.sin(x * 127.1 + s * 311.7) * 43758.5453;
        return v - Math.floor(v);
    };
    const smooth = (u) => u * u * (3 - 2 * u);
    const mixC = (a, b, t) => [
        a[0] + (b[0] - a[0]) * t,
        a[1] + (b[1] - a[1]) * t,
        a[2] + (b[2] - a[2]) * t,
    ];
    const css = (c) => `rgb(${c[0] | 0},${c[1] | 0},${c[2] | 0})`;

    // chaos params per comarca
    const params = paths.map((p, i) => ({
        dur: 4.5 + hash(i, 1) * 4.5, // seconds per full 6-color rotation
        phase: hash(i, 2) * Math.PI * 2,
        dir: hash(i, 3) > 0.5 ? 1 : -1, // some rotate backwards
        amp: 0.8 + hash(i, 4) * 0.2, // brightness amplitude
        breath: 6 + hash(i, 5) * 5, // per-comarca breathing period
        flow: parseFloat(p.dataset.flow || "0.5"),
    }));

    const reduced = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
    ).matches;
    if (!reduced) {
        let raf = 0;
        const frame = () => {
            const t = performance.now() / 1000;
            for (let i = 0; i < paths.length; i++) {
                const q = params[i];
                // hue rotation, chaotic
                let u = (t / q.dur) * q.dir + q.phase / (Math.PI * 2);
                u = u - Math.floor(u); // 0..1
                const seg = u * 6,
                    si = Math.floor(seg) % 6;
                const col = mixC(P[si], P[(si + 1) % 6], smooth(seg - si));
                // 10s flow wave across the map + per-comarca breathing
                const wave =
                    0.5 +
                    0.5 *
                        Math.sin(
                            (Math.PI * 2 * t) / 10 -
                                Math.PI * 2 * q.flow +
                                q.phase,
                        );
                const breath =
                    0.5 +
                    0.5 * Math.sin((Math.PI * 2 * t) / q.breath + q.phase * 2);
                let k = q.amp * (0.55 + 0.45 * wave) * (0.85 + 0.15 * breath);
                k = Math.min(1.22, Math.max(0.55, k));
                // scale toward white when bright, toward black-ish base otherwise
                const arr =
                    k > 1
                        ? mixC(WHITE, col, 2 - k)
                        : mixC(col, BLACK, (1 - k) * 0.55);
                paths[i].style.fill = css(arr);
            }
            raf = requestAnimationFrame(frame);
        };
        raf = requestAnimationFrame(frame);
        document.addEventListener("visibilitychange", () => {
            cancelAnimationFrame(raf);
            if (!document.hidden) raf = requestAnimationFrame(frame);
        });
        // static: initial fills from the markup stay
    }
</script>

<style>
    .pulsing-map {
        width: 100%; /* flex-column parent shrink-wraps otherwise */
        margin: var(--space-8) auto 0;
        max-width: min(900px, 100%);
        background: var(--surface-1);
        border: 1px solid var(--border-subtle);
        box-shadow: var(--shadow-md);
    }
    .pulsing-map svg {
        display: block;
        width: 100%;
        height: auto;
    }
    .pulsing-map .comarca {
        stroke: var(--paper);
        stroke-width: 1.1;
        vector-effect: non-scaling-stroke;
    }
    @media (hover: hover) {
        .pulsing-map .comarca:hover {
            filter: brightness(1.18) saturate(1.3);
        }
    }
    @media (max-width: 720px) {
        .pulsing-map {
            margin-top: var(--space-6);
        }
    }
    @media (prefers-reduced-motion: reduce) {
        .pulsing-map .comarca {
            filter: none;
        }
    }
</style>
