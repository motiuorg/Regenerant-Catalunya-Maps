---
import "@fontsource-variable/fraunces";
import "@fontsource-variable/inter";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "@fontsource/averia-serif-libre/400.css";
import "@fontsource/averia-serif-libre/700.css";
// Styles: structural tokens, the active theme and the base layer all come from
// the shared design system (@motiu/design). This repo keeps only site-local
// overrides (the Fluvià shell palette + src/styles/global.css).
import "@motiu/design/styles/tokens.css";
import "@motiu/design/styles/theme.css";
import "../styles/themes/fluvia-river.css";
import "@motiu/design/styles/global.css";
import "../styles/global.css";
import Nav from "./Nav.astro";
import FluviaNav from "./FluviaNav.astro";
import Footer from "./Footer.astro";
import I18n from "./I18n.astro";
import { loadI18n, type I18nDict } from "../lib/i18n";
import fs from "node:fs";
import path from "node:path";
import yaml from "js-yaml";

const site = yaml.load(
    fs.readFileSync(path.join(process.cwd(), "src/data/site.yaml"), "utf8"),
) as {
    name: string;
    url: string;
    description: string;
    ogImage?: string;
    goatcounter?: string;
};

const uiStrings = loadI18n();

interface Props {
    title: string;
    description?: string;
    current?: string;
    section?: string;
    dataset?: string;
    minimal?: boolean;
    noindex?: boolean;
    /** Which site chrome to render. "fluvia" swaps in the Fluvià watershed navigation. */
    shell?: "main" | "fluvia";
    /** Per-page content strings merged with the shared UI dictionary. */
    i18nDict?: I18nDict;
}
const {
    title,
    description = site.description,
    current = "home",
    section,
    dataset,
    minimal = false,
    noindex = false,
    shell = "main",
    i18nDict,
} = Astro.props;
const mergedDict: I18nDict = { ...uiStrings, ...i18nDict };
const pageTitle = `${title} · ${site.name}`;
const canonical = new URL(Astro.url.pathname, site.url).href;

// This site is served from a sub-path (/Regenerant-Catalunya-Maps/), so asset
// links must be root-absolute (base-prefixed) and share URLs absolute.
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;
const siteRoot = `${site.url.replace(/\/$/, "")}/`;
const favicon = `${base}favicon.svg`;
const appleTouchIcon = `${base}assets/apple-touch-icon.png`;
// Social previews need an absolute, crawler-fetchable image URL.
const ogImage = `${siteRoot}assets/og.png`;

// Cookieless analytics. Same approach as the other Motiu sites: one <script>
// per page, counting by path. Prefix paths with the site code in the dashboard.
const analyticsEndpoint = String(site.goatcounter ?? "").trim();
---

<!doctype html>
<html lang="en" class:list={{ "theme-fluvia": shell === "fluvia" }}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content={description} />
        <meta name="robots" content={noindex ? "noindex" : "index"} />
        <title>{pageTitle}</title>
        <link rel="canonical" href={canonical} />
        <link rel="icon" href={favicon} type="image/svg+xml" />
        <link rel="apple-touch-icon" href={appleTouchIcon} />
        <meta name="theme-color" content="#2C5A0D" />
        {analyticsEndpoint && (
            <>
                <script
                    is:inline
                    data-goatcounter={analyticsEndpoint}
                    async
                    src="https://gc.zgo.at/count.js"
                />
                <script is:inline>
                    // Count loads of the "suggest an entry" CTA as GoatCounter
                    // events, so traffic to the map can be told apart from
                    // actual intent to contribute.
                    document.addEventListener("click", (event) => {
                        const target = event.target;
                        if (!(target instanceof Element)) return;
                        const link = target.closest("[data-goatcounter-event]");
                        if (!link || !window.goatcounter?.count) return;
                        window.goatcounter.count({
                            path: link.getAttribute("data-goatcounter-event"),
                            event: true,
                        });
                    });
                </script>
            </>
        )}
        <I18n dict={mergedDict} />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content={site.name} />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta
            property="og:image:alt"
            content={`${site.name} — who is regenerating Catalunya?`}
        />
        <meta property="og:locale" content="en" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={pageTitle} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage} />
        <slot name="head" />
    </head>
    <body class:list={{ minimal }}>
        {!minimal &&
            (shell === "fluvia" ? (
                <FluviaNav current={current} />
            ) : (
                <Nav current={current} section={section} dataset={dataset} />
            ))}
        <main>
            <slot />
        </main>
        {!minimal && <Footer />}
        <script>
            const els = document.querySelectorAll(
                "main > section, main > header, main > article",
            );
            if ("IntersectionObserver" in window && els.length) {
                const revealIn = (el) => {
                    el.classList.add("reveal");
                    const rect = el.getBoundingClientRect();
                    const inViewport =
                        rect.top < window.innerHeight && rect.bottom > 0;
                    if (inViewport) {
                        el.classList.add("reveal--in");
                    }
                };

                const io = new IntersectionObserver(
                    (entries) => {
                        for (const e of entries) {
                            if (e.isIntersecting) {
                                e.target.classList.add("reveal--in");
                                io.unobserve(e.target);
                            }
                        }
                    },
                    { threshold: 0.01, rootMargin: "0px 0px -50px 0px" },
                );

                els.forEach((el) => {
                    revealIn(el);
                    if (!el.classList.contains("reveal--in")) {
                        io.observe(el);
                    }
                });
            }
        </script>
    </body>
</html>
